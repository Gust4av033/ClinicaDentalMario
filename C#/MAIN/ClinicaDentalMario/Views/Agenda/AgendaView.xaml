<UserControl x:Class="ClinicaDentalMario.Views.Agenda.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource BgWindowBrush}">

    <Border Background="{StaticResource BgCardBrush}" CornerRadius="15" Margin="10" Padding="25" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#000000" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CalendarClock" Width="30" Height="30" Foreground="#E67E22" Margin="0,0,12,0"/>
                    <TextBlock Text="Agenda de Citas" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,25,0">
                    <TextBlock Text="Filtrar por día:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="15"/>
                    <DatePicker SelectedDate="{Binding FechaSeleccionada, UpdateSourceTrigger=PropertyChanged}" 
                                Width="160" FontSize="14" Padding="6" Height="38"/>
                </StackPanel>

                <Button Grid.Column="3" Command="{Binding NuevaCitaCommand}" Height="42" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="20,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CalendarPlus" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                        <TextBlock Text="Agendar Cita" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="{Binding AnchoPanelDetalle}"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,15,0">

                    <DataGrid ItemsSource="{Binding CitasDelDia}" SelectedItem="{Binding CitaSeleccionada}" 
                              AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent" BorderThickness="0" 
                              RowHeight="55" FontSize="14" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hora" Binding="{Binding FechaHora, StringFormat={}{0:hh:mm tt}}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Paciente" Binding="{Binding Paciente}" Width="2*"/>
                            <DataGridTextColumn Header="Doctor Asignado" Binding="{Binding Doctor}" Width="*"/>

                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#E67E22"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{StaticResource BgCardBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CitasDelDia.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CitasDelDia}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="CalendarBlankOutline" Width="80" Height="80" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.2" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="Día libre de citas" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No hay ninguna cita agendada para la fecha seleccionada." FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.8" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource BgControlBrush}" CornerRadius="12" Padding="25" Width="340" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                        Visibility="{Binding PanelDetalleVisibility}">
                    <StackPanel>
                        <Button Command="{Binding CerrarDetalleCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,-10,-10,15" ToolTip="Cerrar panel">
                            <iconPacks:PackIconMaterial Kind="Close" Foreground="{StaticResource TextSecondaryBrush}" Width="22" Height="22"/>
                        </Button>

                        <iconPacks:PackIconMaterial Kind="AccountClock" Width="50" Height="50" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Detalles de la Cita" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                        <TextBlock Text="Paciente:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding CitaSeleccionada.Paciente}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,20" TextWrapping="Wrap"/>

                        <TextBlock Text="Doctor Asignado:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding CitaSeleccionada.Doctor}" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,20"/>

                        <TextBlock Text="Horario:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding CitaSeleccionada.FechaHora, StringFormat={}{0:dd MMM yyyy - hh:mm tt}}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,20"/>

                        <TextBlock Text="Motivo / Observaciones:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                        <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,5,0,30" MinHeight="90">
                            <TextBlock Text="{Binding CitaSeleccionada.Observaciones}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                        </Border>

                        <Button Command="{Binding EditarCitaCommand}" Background="#F39C12" Foreground="White" BorderThickness="0" Height="42" Margin="0,0,0,12" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CalendarEdit" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                                <TextBlock Text="Reprogramar / Editar" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelarCitaCommand}" Background="Transparent" BorderBrush="{StaticResource DangerBrush}" Foreground="{StaticResource DangerBrush}" BorderThickness="1" Height="42" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CalendarRemove" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Cancelar Cita" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Border>
</UserControl>