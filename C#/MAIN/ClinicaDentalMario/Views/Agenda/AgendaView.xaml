<UserControl x:Class="ClinicaDentalMario.Views.Agenda.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <Border Background="White" CornerRadius="15" Margin="10" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D1D8E0" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CalendarClock" Width="28" Height="28" Foreground="#E67E22" Margin="0,0,10,0"/>
                    <TextBlock Text="Agenda de Citas" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Ver día:" Foreground="#7F8C8D" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                    <DatePicker SelectedDate="{Binding FechaSeleccionada, UpdateSourceTrigger=PropertyChanged}" 
                                Width="150" FontSize="14" Padding="5" BorderBrush="#BDC3C7"/>
                </StackPanel>

                <Button Grid.Column="3" Command="{Binding NuevaCitaCommand}" Height="40" Background="#2980B9" Foreground="White" BorderThickness="0" Padding="15,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CalendarPlus" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Agendar Cita" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding CitasDelDia}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" Background="White" BorderThickness="0" 
                      RowBackground="White" AlternatingRowBackground="#F9FAFC"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E5EA"
                      HeadersVisibility="Column" RowHeight="50" FontSize="14">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F6FA"/>
                        <Setter Property="Foreground" Value="#7F8C8D"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E1E5EA"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hora" Binding="{Binding FechaHora, StringFormat=hh:mm tt}" Width="100" FontWeight="SemiBold" Foreground="#2980B9"/>

                    <DataGridTextColumn Header="Paciente" Binding="{Binding Paciente}" Width="*"/>
                    <DataGridTextColumn Header="Doctor Asignado" Binding="{Binding Doctor}" Width="*"/>

                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#7F8C8D"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Acciones" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding DataContext.EditarCitaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" ToolTip="Reprogramar">
                                        <iconPacks:PackIconMaterial Kind="CalendarEdit" Foreground="#F39C12"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.CancelarCitaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Cancelar Cita">
                                        <iconPacks:PackIconMaterial Kind="CalendarRemove" Foreground="#E74C3C"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>