<UserControl x:Class="ClinicaDentalMario.Views.Agenda.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <Border Background="White" CornerRadius="15" Margin="10" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D1D8E0" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CalendarClock" Width="28" Height="28" Foreground="#E67E22" Margin="0,0,10,0"/>
                    <TextBlock Text="Agenda de Citas" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Ver día:" Foreground="#7F8C8D" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                    <DatePicker SelectedDate="{Binding FechaSeleccionada, UpdateSourceTrigger=PropertyChanged}" 
                                Width="150" FontSize="14" Padding="5" BorderBrush="#BDC3C7"/>
                </StackPanel>

                <Button Grid.Column="3" Command="{Binding NuevaCitaCommand}" Height="40" Background="#2980B9" Foreground="White" BorderThickness="0" Padding="15,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CalendarPlus" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Agendar Cita" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="{Binding AnchoPanelDetalle}"/>
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0" ItemsSource="{Binding CitasDelDia}" SelectedItem="{Binding CitaSeleccionada}" 
                          AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderThickness="0" 
                          RowBackground="White" AlternatingRowBackground="#F9FAFC"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E5EA"
                          HeadersVisibility="Column" RowHeight="50" FontSize="14" Margin="0,0,15,0">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F5F6FA"/>
                            <Setter Property="Foreground" Value="#7F8C8D"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E1E5EA"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EAF2F8"/>
                                    <Setter Property="Foreground" Value="#2C3E50"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hora" Binding="{Binding FechaHora, StringFormat=hh:mm tt}" Width="100" FontWeight="SemiBold" Foreground="#2980B9"/>
                        <DataGridTextColumn Header="Paciente" Binding="{Binding Paciente}" Width="*"/>
                        <DataGridTextColumn Header="Doctor" Binding="{Binding Doctor}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="1" Background="#F8F9FA" CornerRadius="10" Padding="20" Width="300" BorderBrush="#E1E5EA" BorderThickness="1" 
                        Visibility="{Binding PanelDetalleVisibility}">
                    <StackPanel>
                        <Button Command="{Binding CerrarDetalleCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,-10,-10,10">
                            <iconPacks:PackIconMaterial Kind="Close" Foreground="#95A5A6" Width="20" Height="20"/>
                        </Button>

                        <iconPacks:PackIconMaterial Kind="AccountClock" Width="40" Height="40" Foreground="#34495E" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Detalles de Cita" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="Paciente:" Foreground="#7F8C8D" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding CitaSeleccionada.Paciente}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15" TextWrapping="Wrap"/>

                        <TextBlock Text="Doctor Asignado:" Foreground="#7F8C8D" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding CitaSeleccionada.Doctor}" FontSize="14" Foreground="#34495E" Margin="0,0,0,15"/>

                        <TextBlock Text="Horario:" Foreground="#7F8C8D" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding CitaSeleccionada.FechaHora, StringFormat='dd MMM yyyy - hh:mm tt'}" FontSize="14" FontWeight="SemiBold" Foreground="#2980B9" Margin="0,0,0,15"/>

                        <TextBlock Text="Motivo / Observaciones:" Foreground="#7F8C8D" FontWeight="SemiBold" FontSize="12"/>
                        <Border Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,25" MinHeight="80">
                            <TextBlock Text="{Binding CitaSeleccionada.Observaciones}" TextWrapping="Wrap" Foreground="#34495E"/>
                        </Border>

                        <Button Command="{Binding EditarCitaCommand}" Background="#F39C12" Foreground="White" BorderThickness="0" Height="40" Margin="0,0,0,10" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CalendarEdit" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Reprogramar / Editar" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelarCitaCommand}" Background="Transparent" BorderBrush="#E74C3C" Foreground="#E74C3C" BorderThickness="1" Height="40" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CalendarRemove" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Cancelar Cita" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>