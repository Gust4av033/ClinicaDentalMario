<UserControl x:Class="ClinicaDentalMario.Views.Agenda.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource BgWindowBrush}">

    <Border Background="{StaticResource BgCardBrush}" CornerRadius="15" Margin="10" Padding="25" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#000000" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CalendarClock" Width="28" Height="28" Foreground="#E67E22" Margin="0,0,12,0"/>
                    <TextBlock Text="Agenda de Citas" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Ver día:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                    <DatePicker SelectedDate="{Binding FechaSeleccionada, UpdateSourceTrigger=PropertyChanged}" 
                                Width="150" FontSize="14" Padding="5"/>
                </StackPanel>

                <Button Grid.Column="3" Command="{Binding NuevaCitaCommand}" Height="40" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="15,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CalendarPlus" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Agendar Cita" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="{Binding AnchoPanelDetalle}"/>
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0" ItemsSource="{Binding CitasDelDia}" SelectedItem="{Binding CitaSeleccionada}" 
                          AutoGenerateColumns="False" CanUserAddRows="False" Background="{StaticResource BgCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" 
                          RowBackground="{StaticResource BgCardBrush}" AlternatingRowBackground="#242424"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          HeadersVisibility="Column" RowHeight="50" FontSize="14" Margin="0,0,15,0">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgControlBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2C3E50"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hora" Binding="{Binding FechaHora, StringFormat=hh:mm tt}" Width="100" FontWeight="Bold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#3498DB"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Paciente" Binding="{Binding Paciente}" Width="*"/>
                        <DataGridTextColumn Header="Doctor" Binding="{Binding Doctor}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#E67E22"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="1" Background="{StaticResource BgControlBrush}" CornerRadius="10" Padding="20" Width="300" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                        Visibility="{Binding PanelDetalleVisibility}">
                    <StackPanel>
                        <Button Command="{Binding CerrarDetalleCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,-10,-10,10">
                            <iconPacks:PackIconMaterial Kind="Close" Foreground="{StaticResource TextSecondaryBrush}" Width="20" Height="20"/>
                        </Button>

                        <iconPacks:PackIconMaterial Kind="AccountClock" Width="40" Height="40" Foreground="#3498DB" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Detalles de Cita" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="Paciente:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding CitaSeleccionada.Paciente}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>

                        <TextBlock Text="Doctor Asignado:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding CitaSeleccionada.Doctor}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                        <TextBlock Text="Horario:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding CitaSeleccionada.FechaHora, StringFormat='dd MMM yyyy - hh:mm tt'}" FontSize="14" FontWeight="SemiBold" Foreground="#3498DB" Margin="0,0,0,15"/>

                        <TextBlock Text="Motivo / Observaciones:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                        <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,25" MinHeight="80">
                            <TextBlock Text="{Binding CitaSeleccionada.Observaciones}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>

                        <Button Command="{Binding EditarCitaCommand}" Background="#F39C12" Foreground="White" BorderThickness="0" Height="40" Margin="0,0,0,10" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CalendarEdit" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Reprogramar / Editar" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelarCitaCommand}" Background="Transparent" BorderBrush="#E74C3C" Foreground="#E74C3C" BorderThickness="1" Height="40" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CalendarRemove" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Cancelar Cita" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E74C3C"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>