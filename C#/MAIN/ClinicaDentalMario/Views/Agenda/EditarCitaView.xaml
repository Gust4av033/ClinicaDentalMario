<UserControl x:Class="ClinicaDentalMario.Views.Agenda.EditarCitaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource BgWindowBrush}">

    <Grid>
        <Border Background="{StaticResource BgCardBrush}"
                CornerRadius="15"
                Padding="35"
                MaxWidth="730"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <iconPacks:PackIconMaterial Kind="CalendarEdit" Width="30" Height="30" Foreground="#F39C12" Margin="0,0,12,0"/>
                    <TextBlock Text="Reprogramar o Editar Cita" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="#3A1C1C" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensajeError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <Border Background="{StaticResource BgControlBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Paciente" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding NombrePaciente}" FontWeight="Bold" FontSize="18"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Doctor asignado *" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding ListaDoctores}"
                              SelectedItem="{Binding DoctorSeleccionado, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                              DisplayMemberPath="NombreCompleto"
                              Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"/>
                </StackPanel>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nueva fecha *" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FechaSeleccionada, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                    Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nueva hora (24 h) *" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding HoraSeleccionada, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                                 MaxLength="5"
                                 ToolTip="Formato HH:mm, por ejemplo 09:30 o 14:30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Duración *" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding DuracionesDisponibles}"
                                  SelectedItem="{Binding DuracionMinutos, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                  Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0} min}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Estado de la cita *" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding ListaEstados}"
                              SelectedItem="{Binding EstadoSeleccionado, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                              DisplayMemberPath="Nombre"
                              Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"/>
                    <TextBlock Text="Solo Pendiente y Confirmada se gestionan aquí. Los estados finales se marcan desde la agenda."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,25">
                    <TextBlock Text="Motivo / observaciones" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                             Height="80"
                             MaxLength="500"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <Border Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,20">
                    <TextBlock Text="Al reprogramar se comprobará que el intervalo completo no se cruce con otra cita activa del mismo doctor."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding VolverCommand}" Background="Transparent" Margin="0,0,15,0">
                        <TextBlock Text="Cancelar" FontWeight="SemiBold"/>
                    </Button>
                    <Button Command="{Binding ActualizarCommand}" Background="#F39C12" Foreground="White" BorderThickness="0" Padding="24,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSaveEdit" Margin="0,0,8,0" Foreground="White"/>
                            <TextBlock Text="Actualizar Cita" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
