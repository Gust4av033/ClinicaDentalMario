<UserControl x:Class="ClinicaDentalMario.Views.Agenda.NuevaCitaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource BgWindowBrush}">

    <Grid>
        <Border Background="{StaticResource BgCardBrush}" CornerRadius="15" Padding="30" MaxWidth="600" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <iconPacks:PackIconMaterial Kind="CalendarPlus" Width="28" Height="28" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="Agendar Nueva Cita" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding MensajeError}" Foreground="#E74C3C" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensajeError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Paciente:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding ListaPacientes}" 
                          SelectedItem="{Binding PacienteSeleccionado}" 
                          DisplayMemberPath="NombreCompleto" 
                          FontSize="14" Padding="8" Margin="0,0,0,15"
                          IsEditable="True" TextSearch.TextPath="NombreCompleto"/>

                <TextBlock Text="Doctor asignado:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding ListaDoctores}" 
                          SelectedItem="{Binding DoctorSeleccionado}" 
                          DisplayMemberPath="NombreCompleto" 
                          FontSize="14" Padding="8" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fecha de la cita:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FechaSeleccionada, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hora (Ej. 14:30):" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding HoraSeleccionada, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Observaciones / Motivo:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NuevaCita.Observaciones, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="14" Padding="8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,25"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CancelarCommand}" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="40" Padding="20,0" Margin="0,0,15,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cancelar" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>

                    <Button Command="{Binding GuardarCommand}" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Height="40" Padding="25,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CalendarCheck" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                            <TextBlock Text="Agendar Cita" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>