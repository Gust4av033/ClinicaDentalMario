<UserControl x:Class="ClinicaDentalMario.Views.Agenda.NuevaCitaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <Grid>
        <Border Background="White" CornerRadius="15" Padding="30" MaxWidth="600" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#D1D8E0" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <iconPacks:PackIconMaterial Kind="CalendarPlus" Width="28" Height="28" Foreground="#2980B9" Margin="0,0,10,0"/>
                    <TextBlock Text="Agendar Nueva Cita" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>

                <TextBlock Text="{Binding MensajeError}" Foreground="#E74C3C" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensajeError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Paciente:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding ListaPacientes}" 
                          SelectedItem="{Binding PacienteSeleccionado}" 
                          DisplayMemberPath="NombreCompleto" 
                          FontSize="14" Padding="8" BorderBrush="#BDC3C7" Margin="0,0,0,15"
                          IsEditable="True" TextSearch.TextPath="NombreCompleto"/>

                <TextBlock Text="Doctor asignado:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding ListaDoctores}" 
                          SelectedItem="{Binding DoctorSeleccionado}" 
                          DisplayMemberPath="NombreCompleto" 
                          FontSize="14" Padding="8" BorderBrush="#BDC3C7" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fecha de la cita:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FechaSeleccionada, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="5" BorderBrush="#BDC3C7"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hora (Ej. 14:30):" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding HoraSeleccionada, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" BorderBrush="#BDC3C7" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Observaciones / Motivo:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NuevaCita.Observaciones, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="14" Padding="8" BorderBrush="#BDC3C7" BorderThickness="1" 
                         Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,25"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CancelarCommand}" Background="Transparent" Foreground="#7F8C8D" BorderBrush="#BDC3C7" BorderThickness="1" Height="40" Padding="20,0" Margin="0,0,15,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cancelar" FontSize="14" FontWeight="SemiBold"/>
                    </Button>

                    <Button Command="{Binding GuardarCommand}" Background="#2980B9" Foreground="White" BorderThickness="0" Height="40" Padding="25,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CalendarCheck" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Agendar Cita" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>