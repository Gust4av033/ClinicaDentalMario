<UserControl x:Class="ClinicaDentalMario.Views.Archivos.ImagenesPacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource BgWindowBrush}">

    <Grid>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="ImageMultiple" Foreground="#9B59B6" Width="28" Height="28" Margin="0,0,10,0"/>
                    <TextBlock Text="Galería de Radiografías y Fotos" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding EliminarImagenCommand}" Margin="0,0,15,0" Height="38" Background="Transparent" Foreground="#E74C3C" BorderBrush="#E74C3C" BorderThickness="1" Padding="15,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TrashCan" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#E74C3C"/>
                            <TextBlock Text="Eliminar Seleccionada" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#E74C3C"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AbrirFormularioCommand}" Height="38" Background="#8E44AD" Foreground="White" BorderThickness="0" Padding="15,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Upload" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                            <TextBlock Text="Subir Nueva Imagen" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#000000" Opacity="0.5"/>
                </Border.Effect>

                <ListBox ItemsSource="{Binding Galeria}" SelectedItem="{Binding ImagenSeleccionada}" 
                         Background="Transparent" BorderThickness="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" Orientation="Horizontal" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="220" Background="{StaticResource BgControlBrush}" CornerRadius="10" Margin="10" Padding="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand" ToolTip="Doble clic para ver en pantalla completa">

                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" 
                                                  Command="{Binding DataContext.VerImagenEnGrandeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                </Border.InputBindings>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" CornerRadius="6" ClipToBounds="True" Background="#121212">
                                        <Image Source="{Binding RutaArchivo}" Stretch="UniformToFill"/>
                                    </Border>

                                    <Button Grid.Row="0" Command="{Binding DataContext.VerImagenEnGrandeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Background="#CC3498DB" Foreground="White" BorderThickness="0" Width="30" Height="30" Cursor="Hand" ToolTip="Abrir imagen">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="15"/>
                                            </Style>
                                        </Button.Resources>
                                        <iconPacks:PackIconMaterial Kind="Eye" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                    </Button>

                                    <StackPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Descripcion}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FechaSubida, StringFormat=dd/MM/yyyy}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding TipoArchivo}" FontSize="10" Foreground="#3498DB" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <Grid Background="#B2000000" Visibility="{Binding FormularioVisibility}">
            <Border Background="{StaticResource BgCardBrush}" CornerRadius="15" Padding="30" MaxWidth="500" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Color="Black" Opacity="0.6"/>
                </Border.Effect>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <iconPacks:PackIconMaterial Kind="FileImagePlusOutline" Width="28" Height="28" Foreground="#9B59B6" Margin="0,0,10,0"/>
                        <TextBlock Text="Anexar Archivo Clínico" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding MensajeError}" Foreground="#E74C3C" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,15">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MensajeError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="1. Selecciona la radiografía o fotografía:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource BgControlBrush}" Padding="10">
                            <TextBlock Text="{Binding NuevaImagen.RutaArchivo}" Foreground="{StaticResource TextPrimaryBrush}" FontStyle="Italic" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Border>

                        <Button Grid.Column="2" Command="{Binding ExplorarArchivoCommand}" Background="{StaticResource BgControlBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FolderSearch" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Explorar..." VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="2. Descripción de la imagen:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NuevaImagen.Descripcion, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="14" Padding="8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,25"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CerrarFormularioCommand}" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="40" Padding="20,0" Margin="0,0,15,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Cancelar" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>

                        <Button Command="{Binding GuardarImagenCommand}" Background="#8E44AD" Foreground="White" BorderThickness="0" Height="40" Padding="25,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CloudUpload" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                                <TextBlock Text="Guardar en Expediente" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>