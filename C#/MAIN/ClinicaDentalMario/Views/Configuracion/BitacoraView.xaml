<UserControl x:Class="ClinicaDentalMario.Views.Configuracion.BitacoraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Resumen -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="180" Margin="0,0,10,8" Padding="14" CornerRadius="10"
                    Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Resultados" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding TotalResultados, StringFormat={}{0:N0}}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Width="180" Margin="0,0,10,8" Padding="14" CornerRadius="10"
                    Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Movimientos de hoy" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding RegistrosHoy, StringFormat={}{0:N0}}" Foreground="#3498DB" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Width="180" Margin="0,0,10,8" Padding="14" CornerRadius="10"
                    Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Accesos fallidos" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding AccesosFallidos, StringFormat={}{0:N0}}" Foreground="#E74C3C" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Width="205" Margin="0,0,0,8" Padding="14" CornerRadius="10"
                    Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Última actualización" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding UltimaActualizacion}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="{StaticResource BgControlBrush}" CornerRadius="10" Padding="14"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <iconPacks:PackIconMaterial Kind="Filter" Width="18" Height="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="Filtros de auditoría" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Por defecto se muestran los últimos 30 días" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </DockPanel>

                <WrapPanel>
                    <StackPanel Width="245" Margin="0,0,10,8">
                        <TextBlock Text="Buscar" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="9,6"
                                 ToolTip="Busca por usuario, acción, tabla, detalle, equipo o IP"/>
                    </StackPanel>

                    <StackPanel Width="155" Margin="0,0,10,8">
                        <TextBlock Text="Usuario" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding UsuariosFiltro}" SelectedItem="{Binding UsuarioSeleccionado}" Height="34"/>
                    </StackPanel>

                    <StackPanel Width="155" Margin="0,0,10,8">
                        <TextBlock Text="Acción" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AccionesFiltro}" SelectedItem="{Binding AccionSeleccionada}" Height="34"/>
                    </StackPanel>

                    <StackPanel Width="185" Margin="0,0,10,8">
                        <TextBlock Text="Tabla / módulo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding TablasFiltro}" SelectedItem="{Binding TablaSeleccionada}" Height="34"/>
                    </StackPanel>

                    <StackPanel Width="140" Margin="0,0,10,8">
                        <TextBlock Text="Desde" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FechaDesde}" Height="34"/>
                    </StackPanel>

                    <StackPanel Width="140" Margin="0,0,10,8">
                        <TextBlock Text="Hasta" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FechaHasta}" Height="34"/>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Margin="0,2,0,0">
                    <Button Command="{Binding BuscarCommand}" Height="34" Padding="14,0" Margin="0,0,8,0"
                            Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Width="17" Height="17" Margin="0,0,6,0"/>
                            <TextBlock Text="Aplicar filtros" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LimpiarFiltrosCommand}" Height="34" Padding="12,0" Margin="0,0,8,0"
                            Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilterRemove" Width="17" Height="17" Margin="0,0,6,0"/>
                            <TextBlock Text="Restablecer"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding MostrarTodoCommand}" Height="34" Padding="12,0" Margin="0,0,8,0"
                            Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="History" Width="17" Height="17" Margin="0,0,6,0"/>
                            <TextBlock Text="Todo el historial"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RecargarCommand}" Height="34" Padding="12,0"
                            Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh" Width="17" Height="17" Margin="0,0,6,0"/>
                            <TextBlock Text="Actualizar"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Mensaje inline -->
        <Border Grid.Row="2" Visibility="{Binding TieneMensaje, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#33E74C3C" BorderBrush="#AAE74C3C" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="{Binding MensajeUsuario}" Foreground="#FFB4AB" TextWrapping="Wrap"/>
        </Border>

        <!-- Tabla -->
        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding RegistrosAuditoria}"
                          SelectedItem="{Binding RegistroSeleccionado, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          Background="{StaticResource BgCardBrush}" BorderThickness="0"
                          RowBackground="{StaticResource BgCardBrush}" AlternatingRowBackground="#242424"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          HeadersVisibility="Column" RowHeight="42" FontSize="13">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgControlBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,9"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha y hora" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding NombreUsuario}" Width="130"/>
                        <DataGridTemplateColumn Header="Acción" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left" Background="#333498DB">
                                        <TextBlock Text="{Binding Accion}" FontSize="11" FontWeight="SemiBold" Foreground="#8FC9F3">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#8FC9F3"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Accion}" Value="INSERT">
                                                            <Setter Property="Foreground" Value="#7ED6A5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Accion}" Value="UPDATE">
                                                            <Setter Property="Foreground" Value="#F4C56B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Accion}" Value="DELETE">
                                                            <Setter Property="Foreground" Value="#FF9A92"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Accion}" Value="LOGIN FALLIDO">
                                                            <Setter Property="Foreground" Value="#FF9A92"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Módulo" Binding="{Binding Modulo}" Width="115"/>
                        <DataGridTextColumn Header="Entidad" Binding="{Binding Entidad}" Width="145"/>
                        <DataGridTextColumn Header="Detalle" Binding="{Binding Detalles}" Width="*" MinWidth="250">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding Detalles}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Cargando bitácora..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding SinResultados, Converter={StaticResource BoolToVisibilityConverter}}">
                    <iconPacks:PackIconMaterial Kind="Magnify" Width="34" Height="34" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No hay movimientos que coincidan con los filtros." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pie + detalle -->
        <StackPanel Grid.Row="4">
            <Grid Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CantidadEnPagina, StringFormat={}{0} registros en esta página}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="   •   Mostrar" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding TamanosPagina}" SelectedItem="{Binding TamanoPagina}" Width="65" Height="28" Margin="7,0"/>
                    <TextBlock Text="por página" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding PaginaAnteriorCommand}" Width="34" Height="30" Margin="0,0,8,0" ToolTip="Página anterior">
                        <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="18" Height="18"/>
                    </Button>
                    <TextBlock Text="{Binding PaginaTexto}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Command="{Binding PaginaSiguienteCommand}" Width="34" Height="30" ToolTip="Página siguiente">
                        <iconPacks:PackIconMaterial Kind="ChevronRight" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Visibility="{Binding TieneRegistroSeleccionado, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Usuario" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding RegistroSeleccionado.NombreUsuario}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RegistroSeleccionado.Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Origen" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding RegistroSeleccionado.Equipo, TargetNullValue=No registrado}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding RegistroSeleccionado.IP, TargetNullValue=IP no registrada}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Acción / tabla" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding RegistroSeleccionado.Accion}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RegistroSeleccionado.Tabla}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="Detalle completo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding RegistroSeleccionado.Detalles}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" MaxHeight="70"/>
                    </StackPanel>

                    <Button Grid.Column="4" Command="{Binding CerrarDetalleCommand}" Width="30" Height="30" Background="Transparent" BorderThickness="0" ToolTip="Cerrar detalle">
                        <iconPacks:PackIconMaterial Kind="Close" Width="18" Height="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
