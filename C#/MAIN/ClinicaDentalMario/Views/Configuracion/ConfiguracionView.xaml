<UserControl x:Class="ClinicaDentalMario.Views.Configuracion.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:vistas="clr-namespace:ClinicaDentalMario.Views.Configuracion"
             xmlns:vistasUsuarios="clr-namespace:ClinicaDentalMario.Views.Usuarios"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource BgWindowBrush}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" CornerRadius="14" Padding="20"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="#253498DB" Margin="0,0,14,0">
                    <iconPacks:PackIconMaterial Kind="Cog" Width="25" Height="25" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Ajustes y administración" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Catálogo clínico, doctores, usuarios del sistema y auditoría de seguridad."
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="9" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Shield" Width="17" Height="17" Foreground="#7ED6A5" Margin="0,0,7,0"/>
                        <TextBlock Text="Área administrativa" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="14" Padding="18"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="16,10"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0,0,0,3"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="Catálogo de tratamientos">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*" MinWidth="310"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BgControlBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tratamientos activos" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Border Background="#253498DB" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding CantidadTratamientos}" Foreground="#8FC9F3" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <Button Command="{Binding RecargarTratamientosCommand}" HorizontalAlignment="Right" Height="32" Padding="10,0"
                                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" Margin="0,0,5,0"/>
                                            <TextBlock Text="Actualizar"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <DataGrid ItemsSource="{Binding ListaTratamientos}"
                                              SelectedItem="{Binding TratamientoSeleccionado, Mode=TwoWay}"
                                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                              SelectionMode="Single" SelectionUnit="FullRow"
                                              Background="{StaticResource BgControlBrush}" BorderThickness="0"
                                              RowBackground="{StaticResource BgControlBrush}" AlternatingRowBackground="#242424"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                              HeadersVisibility="Column" RowHeight="42" FontSize="13">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="10,9"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            </Style>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="10,0"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGrid.Resources>

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tratamiento" Binding="{Binding Nombre}" Width="*" MinWidth="170"/>
                                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioBase, StringFormat={}{0:C2}}" Width="105"/>
                                            <DataGridTextColumn Header="Duración" Binding="{Binding DuracionMinutos, StringFormat={}{0} min}" Width="90"/>
                                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="1.2*" MinWidth="180">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding Descripcion}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding SinTratamientos, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="No hay tratamientos activos en el catálogo." Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource BgControlBrush}" Padding="18" CornerRadius="10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TituloFormularioTratamiento}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Selecciona una fila para editarla o crea una nueva entrada."
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Command="{Binding NuevoTratamientoCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Width="32" Height="32" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" ToolTip="Nuevo tratamiento">
                                        <iconPacks:PackIconMaterial Kind="Plus" Width="18" Height="18"/>
                                    </Button>
                                </Grid>

                                <TextBlock Text="Nombre" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NombreTratamiento, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,5" Margin="0,0,0,12"/>

                                <TextBlock Text="Descripción" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DescripcionTratamiento, UpdateSourceTrigger=PropertyChanged}" Height="62" Padding="8,6"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Precio base ($)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding PrecioBaseTexto, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Duración (min)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DuracionMinutosTexto, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,5"/>
                                    </StackPanel>
                                </Grid>

                                <Border Visibility="{Binding TieneMensaje, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="#253498DB" BorderBrush="#553498DB" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding MensajeUsuario}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="12"/>
                                </Border>

                                <Button Command="{Binding GuardarTratamientoCommand}" Height="38" Background="{StaticResource AccentBrush}"
                                        Foreground="White" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="ContentSave" Width="17" Height="17" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding TextoBotonGuardar}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding DesactivarTratamientoCommand}" Height="35" Margin="0,9,0,0"
                                        Background="Transparent" Foreground="#FF9A92" BorderBrush="#886B3030" BorderThickness="1" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="17" Height="17" Margin="0,0,6,0"/>
                                        <TextBlock Text="Desactivar seleccionado" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="La desactivación es lógica: no elimina historiales ni tratamientos ya registrados."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Doctores y personal clínico">
                    <Grid Margin="0,10,0,0">
                        <vistas:DoctoresConfiguracionView />
                    </Grid>
                </TabItem>

                <TabItem Header="Usuarios y acceso">
                    <Grid Margin="0,10,0,0">
                        <vistasUsuarios:UsuariosView />
                    </Grid>
                </TabItem>

                <TabItem Header="Bitácora de seguridad">
                    <Grid Margin="0,16,0,0">
                        <vistas:BitacoraView />
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
