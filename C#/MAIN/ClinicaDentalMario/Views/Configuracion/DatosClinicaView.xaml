<UserControl x:Class="ClinicaDentalMario.Views.Configuracion.DatosClinicaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="680" HorizontalAlignment="Stretch">
        <TextBlock Text="Datos de la clínica" FontSize="17" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
        <TextBlock Text="Guarda estos datos una vez para reutilizarlos en las próximas incapacidades. Puedes hacerlo sin emitir un documento."
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <TextBlock Text="Nombre de la clínica *" Margin="0,0,0,5"/>
        <TextBox Text="{Binding Clinica, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" MinHeight="34"/>
        <TextBlock Text="Dirección" Margin="0,12,0,5"/>
        <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" MaxLength="250"
                 TextWrapping="Wrap" MinHeight="50"/>
        <TextBlock Text="Teléfono" Margin="0,12,0,5"/>
        <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" MinHeight="34"/>
        <WrapPanel Margin="0,16,0,0">
            <Button Content="Guardar datos de la clínica" Command="{Binding GuardarCommand}"
                    Background="{StaticResource AccentBrush}" Foreground="White" Padding="12,8" Margin="0,0,10,8"/>
            <Button Content="Recargar guardados" Command="{Binding RecargarCommand}" Padding="12,8" Margin="0,0,0,8"/>
        </WrapPanel>
        <TextBlock Text="{Binding MensajeUsuario}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
        <TextBlock Text="Los datos se guardan para este usuario de Windows en esta computadora. Los certificados ya emitidos conservan sus datos originales."
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
