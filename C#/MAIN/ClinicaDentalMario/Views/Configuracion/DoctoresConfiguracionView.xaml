<UserControl x:Class="ClinicaDentalMario.Views.Configuracion.DoctoresConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <Grid Margin="2,6,2,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#253498DB" BorderBrush="#553498DB" BorderThickness="1"
                CornerRadius="9" Padding="11" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="InformationOutline" Width="18" Height="18"
                                                Foreground="{StaticResource AccentBrush}" Margin="0,1,8,0"/>
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap">
                    <Run Text="El perfil clínico del doctor se usa en Agenda, tratamientos e historiales. "/>
                    <Run Text="No crea automáticamente una cuenta de acceso al sistema; las cuentas se administran en la pestaña Usuarios y acceso." FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.05*" MinWidth="540"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="135" Padding="11" Margin="0,0,8,0" CornerRadius="9"
                                Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Total" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalDoctores}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Width="135" Padding="11" Margin="0,0,8,0" CornerRadius="9"
                                Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Activos" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalActivos}" FontSize="20" FontWeight="Bold" Foreground="#7ED6A5"/>
                            </StackPanel>
                        </Border>
                        <Border Width="135" Padding="11" CornerRadius="9"
                                Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Inactivos" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalInactivos}" FontSize="20" FontWeight="Bold" Foreground="#FF9A92"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Command="{Binding CargarCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Height="34" Padding="11,0" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Actualizar"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,10">
                    <WrapPanel>
                        <StackPanel Width="275" Margin="0,0,10,0">
                            <TextBlock Text="Buscar" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" Height="33" Padding="8,5"
                                     ToolTip="Nombre, especialidad, JVPO o teléfono"/>
                        </StackPanel>
                        <StackPanel Width="145" Margin="0,0,10,0">
                            <TextBlock Text="Estado" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding EstadosFiltro}" SelectedItem="{Binding EstadoSeleccionado}" Height="33"/>
                        </StackPanel>
                        <Button Command="{Binding LimpiarFiltrosCommand}" Height="33" Padding="11,0" Margin="0,14,0,0"
                                Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" Cursor="Hand">
                            <TextBlock Text="Limpiar filtros"/>
                        </Button>
                    </WrapPanel>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Doctores}" SelectedItem="{Binding DoctorSeleccionado, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  Background="{StaticResource BgControlBrush}" BorderThickness="0"
                                  RowBackground="{StaticResource BgControlBrush}" AlternatingRowBackground="#242424"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  HeadersVisibility="Column" RowHeight="43" FontSize="13">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,9"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="*" MinWidth="185"/>
                                <DataGridTextColumn Header="Especialidad" Binding="{Binding Especialidad}" Width="145"/>
                                <DataGridTextColumn Header="JVPO" Binding="{Binding NumeroJVPO}" Width="105"/>
                                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="110"/>
                                <DataGridTemplateColumn Header="Estado" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,3" CornerRadius="9" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#336B3030"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Activo}" Value="True">
                                                                <Setter Property="Background" Value="#333B8F62"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Inactivo"/>
                                                            <Setter Property="Foreground" Value="#FF9A92"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="True">
                                                                    <Setter Property="Text" Value="Activo"/>
                                                                    <Setter Property="Foreground" Value="#7ED6A5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Cargando doctores..." HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding SinDoctores, Converter={StaticResource BoolToVisibilityConverter}}">
                            <iconPacks:PackIconMaterial Kind="AccountSearch" Width="32" Height="32"
                                                        Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No hay doctores que coincidan con los filtros."
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="17" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding TituloFormulario}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Selecciona un registro para editarlo o crea uno nuevo."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,35,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Command="{Binding NuevoCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="32" Height="32" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" ToolTip="Nuevo doctor">
                            <iconPacks:PackIconMaterial Kind="Plus" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Nombre completo *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,5" Margin="0,0,0,10"/>

                    <TextBlock Text="Especialidad" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Especialidad, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,5" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Teléfono" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Número JVPO" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NumeroJVPO, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,5"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Correo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,5" Margin="0,0,0,10"/>

                    <TextBlock Text="Dirección" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" Height="58" Padding="8,6"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,11"/>

                    <Border Visibility="{Binding TieneMensaje, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#253498DB" BorderBrush="#553498DB" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,11">
                        <TextBlock Text="{Binding MensajeUsuario}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="11"/>
                    </Border>

                    <Button Command="{Binding GuardarCommand}" Height="38" Background="{StaticResource AccentBrush}"
                            Foreground="White" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="ContentSave" Width="17" Height="17" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TextoBotonGuardar}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CambiarEstadoCommand}" Height="35" Margin="0,9,0,0"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand">
                        <TextBlock Text="{Binding TextoBotonEstado}" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
