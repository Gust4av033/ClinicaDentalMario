<UserControl x:Class="ClinicaDentalMario.Views.Documentos.DocumentosClinicosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Titulo}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock Text="Incapacidades y reposos · emisión, consulta y reimpresión"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,16"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <Button Content="Volver al expediente" Command="{Binding VolverCommand}" Margin="0,0,10,6">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding PuedeVolver}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></Button.Style>
            </Button>
            <Button Content="Nueva incapacidad / reposo" Command="{Binding NuevoCommand}"
                    Background="{StaticResource AccentBrush}" Foreground="White" Margin="0,0,10,6"/>
            <Button Content="Actualizar" Command="{Binding RecargarCommand}" Margin="0,0,10,6"/>
            <Button Content="Abrir carpeta" Command="{Binding AbrirCarpetaCommand}" Margin="0,0,0,6"/>
        </WrapPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Buscar por paciente, documento de identidad o referencia interna" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
        </StackPanel>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Documentos}" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True" RowHeight="44" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Emitido" Binding="{Binding CreadoEl, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="135"/>
                <DataGridTextColumn Header="Paciente" Binding="{Binding Paciente}" Width="*" MinWidth="130"/>
                <DataGridTextColumn Header="Desde" Binding="{Binding Desde, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                <DataGridTextColumn Header="Hasta" Binding="{Binding Hasta, StringFormat={}{0:dd/MM/yyyy}}" Width="90"/>
                <DataGridTextColumn Header="Días" Binding="{Binding TotalDias}" Width="45"/>
                <DataGridTemplateColumn Header="Documento" Width="155">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                        <Button Content="Abrir" Padding="8,4" Margin="0,0,5,0" CommandParameter="{Binding}"
                                Command="{Binding DataContext.AbrirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" ToolTip="Abrir PDF para consultar o imprimir"/>
                        <Button Content="Copiar PDF" Padding="8,4" CommandParameter="{Binding}"
                                Command="{Binding DataContext.ExportarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="Carpeta del historial: incluirla en los respaldos de la clínica."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Text="{Binding CarpetaArchivo}" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>
    </Grid>
</UserControl>
