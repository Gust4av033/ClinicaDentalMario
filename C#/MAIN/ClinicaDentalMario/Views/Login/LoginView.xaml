<Window x:Class="ClinicaDentalMario.Views.Login.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Acceso al Sistema - CDMario Dental" Height="545" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgWindowBrush}">

    <Grid>
        <Border Background="{StaticResource BgCardBrush}" CornerRadius="15" Padding="30" Margin="25" VerticalAlignment="Center" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Color="#000000" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,25">
                    <iconPacks:PackIconMaterial Kind="ToothOutline" Width="48" Height="48" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="CDMario Dental" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center"/>
                    <TextBlock Text="Sistema de Gestión Clínica" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Text="Usuario:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                         Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                         MaxLength="50"
                         FontSize="14"
                         Padding="10"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Contraseña:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" FontSize="14" Padding="10" Margin="0,0,0,15"/>

                <TextBlock Text="{Binding MensajeError}" Foreground="#E74C3C" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Text="Validando credenciales..."
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EstaCargando}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding SalirCommand}" Background="{StaticResource BgControlBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="45" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ExitToApp" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="Salir" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding AccederCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="#27AE60"
                            Foreground="White"
                            BorderThickness="0"
                            Height="45"
                            Cursor="Hand"
                            IsDefault="True">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Login" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                            <TextBlock Text="Acceder al Sistema" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
