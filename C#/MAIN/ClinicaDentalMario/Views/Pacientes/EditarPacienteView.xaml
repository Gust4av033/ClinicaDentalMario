<UserControl x:Class="ClinicaDentalMario.Views.Pacientes.EditarPacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource BgWindowBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <Border Background="{StaticResource BgCardBrush}"
                CornerRadius="15"
                Padding="35"
                MaxWidth="850"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Command="{Binding RegresarCommand}" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" ToolTip="Regresar al listado">
                            <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="28" Height="28" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                        <iconPacks:PackIconMaterial Kind="AccountEdit" Width="28" Height="28" Foreground="#F39C12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Editar Datos del Paciente" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Aquí se actualizan los datos generales y antecedentes base. Las consultas, odontograma, tratamientos, pagos y archivos se gestionan desde el expediente clínico."
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="45,0,0,12"/>

                    <Border Background="#3A1C1C" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="45,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MensajeError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Datos personales" FontSize="16" FontWeight="Bold" Foreground="#F39C12" Margin="0,0,0,15"/>

                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,15">
                        <TextBlock Text="Nombre completo *" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox MaxLength="150" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Text="{Binding NombreCompleto, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
                        <TextBlock Text="DUI (00000000-0)" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox MaxLength="10" PreviewTextInput="ValidarNumeros_PreviewTextInput" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Text="{Binding DUI, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
                        <TextBlock Text="Teléfono *" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox MaxLength="9" PreviewTextInput="ValidarNumeros_PreviewTextInput" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,15">
                        <TextBlock Text="Fecha de nacimiento" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <DatePicker Padding="8,6" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" SelectedDate="{Binding FechaNacimiento, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,15">
                        <TextBlock Text="Sexo" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <ComboBox SelectedValuePath="Content" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" SelectedValue="{Binding Sexo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}">
                            <ComboBoxItem Content="Masculino"/><ComboBoxItem Content="Femenino"/><ComboBoxItem Content="Otro"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,0,0,15">
                        <TextBlock Text="Dirección" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox MaxLength="250" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,0,0,15">
                    <TextBlock Text="Antecedentes generales" FontSize="16" FontWeight="Bold" Foreground="#F39C12"/>
                    <TextBlock Text="Estos datos forman parte del expediente base del paciente y pueden actualizarse cuando cambie su condición."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <Border Background="#3A3218" BorderBrush="#F39C12" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0"
                            Visibility="{Binding MostrarAvisoAntecedentesSinRegistro, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AlertOutline" Foreground="#F39C12" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Este paciente fue creado antes del registro de antecedentes generales. Revisa esta sección; al guardar se creará su registro base."
                                       Foreground="#F6C56B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="4" Margin="0,0,0,22" IsEnabled="{Binding AntecedentesCargados}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding TieneAntecedentesMedicos, UpdateSourceTrigger=PropertyChanged}" Content="Presenta antecedentes médicos" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Text="Detalle" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <TextBox Height="82" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding TieneAntecedentesMedicos}"
                                     Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Text="{Binding DetalleAntecedentesMedicos, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding TieneAntecedentesOdontologicos, UpdateSourceTrigger=PropertyChanged}" Content="Presenta antecedentes odontológicos" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Text="Detalle" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <TextBox Height="82" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding TieneAntecedentesOdontologicos}"
                                     Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Text="{Binding DetalleAntecedentesOdontologicos, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="5" Text="Contacto y emergencia" FontSize="16" FontWeight="Bold" Foreground="#F39C12" Margin="0,0,0,15"/>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,0,0,15">
                        <TextBlock Text="Nombre del encargado (si aplica)" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox MaxLength="150" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Text="{Binding NombreEncargado, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,15">
                        <TextBlock Text="Contacto de emergencia" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox MaxLength="150" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Text="{Binding ContactoEmergencia, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,15">
                        <TextBlock Text="Teléfono de emergencia" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBox Width="220" MaxLength="9" PreviewTextInput="ValidarNumeros_PreviewTextInput" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" Text="{Binding TelefonoEmergencia, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                    </StackPanel>

                    <Button Grid.Row="2" Grid.Column="0" Command="{Binding CambiarEstadoCommand}" BorderThickness="0" Padding="20,10">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#E74C3C"/><Setter Property="Foreground" Value="White"/><Setter Property="Content" Value="Desactivar Paciente"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Activo}" Value="False"><Setter Property="Background" Value="#3498DB"/><Setter Property="Content" Value="Restaurar Paciente"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding RegresarCommand}" Height="42" Padding="20,0" Margin="0,0,12,0"><TextBlock Text="Regresar" FontWeight="SemiBold"/></Button>
                        <Button Command="{Binding GuardarCambiosCommand}" Background="#F39C12" Foreground="White" BorderThickness="0" Height="42" Padding="25,0">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="ContentSaveEdit" Margin="0,0,8,0" Foreground="White"/><TextBlock Text="Actualizar Datos" FontWeight="Bold" Foreground="White"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
