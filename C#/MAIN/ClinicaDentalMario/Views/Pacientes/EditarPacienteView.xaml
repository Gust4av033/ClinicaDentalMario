<UserControl x:Class="ClinicaDentalMario.Views.Pacientes.EditarPacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
        <Border Background="White" CornerRadius="15" Padding="35" MaxWidth="800">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#D1D8E0" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Command="{Binding RegresarCommand}" Background="Transparent" BorderThickness="0" Margin="0,0,15,0" Cursor="Hand" ToolTip="Regresar al listado">
                            <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="28" Height="28" Foreground="#95A5A6"/>
                        </Button>
                        <iconPacks:PackIconMaterial Kind="AccountEdit" Width="28" Height="28" Foreground="#F39C12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Editar Expediente de Paciente" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding MensajeError}" Foreground="#E74C3C" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MensajeError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding MensajeExito}" Foreground="#27AE60" FontWeight="SemiBold" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MensajeExito}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,15">
                        <TextBlock Text="Nombre Completo:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PacienteActual.NombreCompleto, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,15">
                        <TextBlock Text="Dirección:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PacienteActual.Direccion, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,15">
                        <TextBlock Text="Fecha de Nacimiento:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding PacienteActual.FechaNacimiento}" FontSize="14" Padding="7" BorderBrush="#BDC3C7"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,15">
                        <TextBlock Text="Sexo:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox SelectedValue="{Binding PacienteActual.Sexo}" SelectedValuePath="Content" FontSize="14" Padding="7" BorderBrush="#BDC3C7">
                            <ComboBoxItem Content="Masculino"/>
                            <ComboBoxItem Content="Femenino"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,15">
                        <TextBlock Text="Número de DUI:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PacienteActual.DUI, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,15">
                        <TextBlock Text="Teléfono:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PacienteActual.Telefono, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,15">
                        <TextBlock Text="Contacto de Emergencia:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PacienteActual.ContactoEmergencia, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,15">
                        <TextBlock Text="Tel. de Emergencia:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PacienteActual.TelefonoEmergencia, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,0,0,25">
                    <TextBlock Text="Motivo de última consulta:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding HistorialActual.MotivoConsulta, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

                    <TextBlock Text="Antecedentes Médicos:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding HistorialActual.AntecedentesMedicos, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

                    <TextBlock Text="Antecedentes Odontológicos:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding HistorialActual.AntecedentesOdontologicos, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10" BorderBrush="#BDC3C7" BorderThickness="1" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding DesactivarCommand}" Background="Transparent" Foreground="#E74C3C" BorderBrush="#E74C3C" BorderThickness="1" Height="45" Padding="20,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AccountOff" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Desactivar" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding RegresarCommand}" Background="#95A5A6" Foreground="White" BorderThickness="0" Height="45" Padding="20,0" Margin="0,0,12,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ArrowLeft" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Regresar" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportarPdfCommand}" Background="#E67E22" Foreground="White" BorderThickness="0" Height="45" Padding="20,0" Margin="0,0,12,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FilePdfBox" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="PDF" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding GuardarCambiosCommand}" Background="#F39C12" Foreground="White" BorderThickness="0" Height="45" Padding="25,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ContentSaveEdit" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Actualizar Datos" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>