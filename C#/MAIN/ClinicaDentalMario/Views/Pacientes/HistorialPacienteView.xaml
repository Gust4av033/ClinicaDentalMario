<UserControl x:Class="ClinicaDentalMario.Views.Pacientes.HistorialPacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:archivos="clr-namespace:ClinicaDentalMario.Views.Archivos"
             xmlns:pacientes="clr-namespace:ClinicaDentalMario.Views.Pacientes"
             Background="{StaticResource BgWindowBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding VolverCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" ToolTip="Regresar">
                    <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="28" Height="28" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>
                <iconPacks:PackIconMaterial Kind="FolderAccount" Width="30" Height="30" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Expediente Clínico" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Command="{Binding AbrirNuevaConsultaCommand}" HorizontalAlignment="Right" Height="42" Background="{StaticResource SuccessBrush}" Foreground="White" BorderThickness="0" Padding="20,0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                    <TextBlock Text="Nueva Consulta" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="White"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding PacienteActual.NombreCompleto}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <iconPacks:PackIconMaterial Kind="Phone" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PacienteActual.Telefono}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" Margin="0,0,25,0" VerticalAlignment="Center"/>

                    <iconPacks:PackIconMaterial Kind="CardAccountDetails" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PacienteActual.DUI}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="20,12" BorderBrush="Transparent" BorderThickness="0,0,0,3" Margin="0,0,5,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgControlHoverBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Historial Clínico">
                <Border Background="{StaticResource BgCardBrush}" CornerRadius="0,8,8,8" Padding="15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <DataGrid ItemsSource="{Binding HistorialConsultas}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" Background="{StaticResource BgCardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                  RowBackground="{StaticResource BgCardBrush}" AlternatingRowBackground="{StaticResource BgControlBrush}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  HeadersVisibility="Column" RowHeight="45" FontSize="14">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource BgControlBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,12"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaConsulta, StringFormat={}{0:dd/MM/yyyy}}" Width="120" FontWeight="Bold">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Motivo de Consulta" Binding="{Binding MotivoConsulta}" Width="*"/>
                                <DataGridTextColumn Header="Diagnóstico" Binding="{Binding Diagnostico}" Width="*"/>
                                <DataGridTemplateColumn Header="Acción" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.VerDetalleConsultaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Ver detalle completo" HorizontalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="Eye" Foreground="{StaticResource AccentBrush}" Width="20" Height="20"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="{StaticResource BgCardBrush}" Margin="0,40,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HistorialConsultas.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HistorialConsultas}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="ClipboardTextOffOutline" Width="70" Height="70" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.3" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                <TextBlock Text="El historial clínico está vacío" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Haz clic en 'Nueva Consulta' para registrar la primera visita." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.8" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Odontograma Digital">
                <pacientes:OdontogramaView DataContext="{Binding OdontogramaVM}"/>
            </TabItem>

            <TabItem Header="Galería de Imágenes">
                <archivos:ImagenesPacienteView DataContext="{Binding GaleriaVM}"/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
