<UserControl x:Class="ClinicaDentalMario.Views.Pacientes.HistorialPacienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:archivos="clr-namespace:ClinicaDentalMario.Views.Archivos"
             xmlns:pacientes="clr-namespace:ClinicaDentalMario.Views.Pacientes"
             Background="{StaticResource BgWindowBrush}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding VolverCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="0,0,12,0"
                        ToolTip="Regresar a pacientes">
                    <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="27" Height="27"
                                                Foreground="{StaticResource TextSecondaryBrush}"/>
                </Button>

                <iconPacks:PackIconMaterial Kind="FolderAccount" Width="31" Height="31"
                                            Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>

                <StackPanel>
                    <TextBlock Text="Expediente Clínico" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="{Binding PacienteActual.IdPaciente, StringFormat='Expediente #{0:00000}'}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding RecargarCommand}" Width="42" Height="42"
                        Padding="0" Margin="0,0,10,0" ToolTip="Recargar expediente">
                    <iconPacks:PackIconMaterial Kind="Refresh" Width="19" Height="19"/>
                </Button>

                <Button Command="{Binding EditarPacienteCommand}" Height="42"
                        Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="14,0" Margin="0,0,10,0" ToolTip="Editar datos y antecedentes">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AccountEdit" Margin="0,0,7,0"
                                                    Foreground="#F39C12"/>
                        <TextBlock Text="Editar datos" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding AbrirNuevaConsultaCommand}" Height="42"
                        Background="{StaticResource SuccessBrush}" Foreground="White"
                        BorderThickness="0" Padding="18,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" Margin="0,0,8,0" Foreground="White"/>
                        <TextBlock Text="Nueva Consulta" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MENSAJES -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <Border Background="#3A1C1C" BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Information" Foreground="{StaticResource DangerBrush}"
                                                Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource DangerBrush}"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,8,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EstaCargando}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="Cargando expediente clínico..."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- DATOS GENERALES -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" CornerRadius="12"
                Padding="20" Margin="0,0,0,14" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding PacienteActual.NombreCompleto}" FontSize="22"
                               FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>

                    <WrapPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                            <iconPacks:PackIconMaterial Kind="CalendarClock" Foreground="{StaticResource TextSecondaryBrush}"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding PacienteActual.Edad, StringFormat={}{0} años}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                            <TextBlock Text="Sexo: " Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding PacienteActual.Sexo, TargetNullValue='No especificado'}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                            <iconPacks:PackIconMaterial Kind="Phone" Foreground="{StaticResource TextSecondaryBrush}"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding PacienteActual.Telefono, TargetNullValue='Sin teléfono'}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                            <iconPacks:PackIconMaterial Kind="CardAccountDetails" Foreground="{StaticResource TextSecondaryBrush}"
                                                        Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding PacienteActual.DUI, TargetNullValue='Sin DUI'}"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource BgControlBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="20,0,0,0" MinWidth="175">
                    <StackPanel>
                        <TextBlock Text="Estado del expediente" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"/>
                        <TextBlock FontWeight="Bold" FontSize="15" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Activo"/>
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PacienteActual.Activo}" Value="False">
                                            <Setter Property="Text" Value="Inactivo"/>
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ANTECEDENTES BASE -->
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Antecedentes médicos" FontWeight="Bold" FontSize="15"
                                   Foreground="#F39C12"/>
                        <TextBlock Text="{Binding ResumenAntecedentesMedicos}"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Antecedentes odontológicos" FontWeight="Bold" FontSize="15"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding ResumenAntecedentesOdontologicos}"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#3A3219" BorderBrush="#C99A20" BorderThickness="1"
                    CornerRadius="8" Padding="9" Margin="0,8,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TieneAntecedentesRegistrados}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="Este paciente todavía no tiene antecedentes generales confirmados. Puedes registrarlos desde Editar Paciente."
                           Foreground="#E6C965" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- SECCIONES DEL EXPEDIENTE -->
        <TabControl Grid.Row="4" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        Padding="18,11" BorderBrush="Transparent"
                                        BorderThickness="0,0,0,3" Margin="0,0,4,0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgControlHoverBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Historial Clínico">
                <Border Background="{StaticResource BgCardBrush}" CornerRadius="0,8,8,8"
                        Padding="15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <DataGrid ItemsSource="{Binding HistorialConsultas}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True" RowHeight="46"
                                  FontSize="14" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha"
                                                    Binding="{Binding FechaConsulta, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                    Width="145"/>
                                <DataGridTextColumn Header="Doctor" Binding="{Binding Doctor}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Motivo de consulta" Binding="{Binding MotivoConsulta}"
                                                    Width="1.5*"/>
                                <DataGridTextColumn Header="Diagnóstico" Binding="{Binding Diagnostico}"
                                                    Width="1.5*"/>
                                <DataGridTemplateColumn Header="Detalle" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.VerDetalleConsultaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Background="Transparent"
                                                    BorderThickness="0" Padding="5" ToolTip="Ver detalle de consulta">
                                                <iconPacks:PackIconMaterial Kind="Eye" Foreground="{StaticResource AccentBrush}"
                                                                            Width="20" Height="20"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="{StaticResource BgCardBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SinConsultas}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="ClipboardTextOffOutline" Width="62" Height="62"
                                                            Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.3"
                                                            HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Aún no hay consultas clínicas" FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Usa Nueva Consulta para registrar la primera atención."
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Odontograma Digital">
                <pacientes:OdontogramaView DataContext="{Binding OdontogramaVM}"/>
            </TabItem>

            <TabItem Header="Galería de Imágenes">
                <archivos:ImagenesPacienteView DataContext="{Binding GaleriaVM}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
