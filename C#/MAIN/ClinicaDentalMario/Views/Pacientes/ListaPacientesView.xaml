<UserControl x:Class="ClinicaDentalMario.Views.Pacientes.ListaPacientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <Border Background="White" CornerRadius="15" Margin="10" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D1D8E0" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="AccountGroup" Width="24" Height="24" Foreground="#2C3E50" Margin="0,0,10,0"/>
                    <TextBlock Text="Pacientes Registrados" FontSize="22" FontWeight="SemiBold" Foreground="#2C3E50"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#F5F6FA" CornerRadius="20" Height="40" MaxWidth="400" Margin="20,0" Padding="15,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="Magnify" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding TerminoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="10,0,0,0" 
                                 FontSize="14" Foreground="#2C3E50"/>
                    </Grid>
                </Border>

                <Button Grid.Column="2" Command="{Binding NuevoPacienteCommand}" Height="40" Background="#27AE60" Foreground="White" BorderThickness="0" Padding="15,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Nuevo Paciente" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Pacientes}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" Background="White" BorderThickness="0" 
                      RowBackground="White" AlternatingRowBackground="#F9FAFC"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E5EA"
                      HeadersVisibility="Column" RowHeight="45" FontSize="14">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F6FA"/>
                        <Setter Property="Foreground" Value="#7F8C8D"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E1E5EA"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Expediente" Binding="{Binding IdPaciente}" Width="100"/>
                    <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="*"/>
                    <DataGridTextColumn Header="DUI" Binding="{Binding DUI}" Width="150"/>
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="150"/>

                    <DataGridTemplateColumn Header="Acciones" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding DataContext.EditarPacienteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Editar Datos" Margin="0,0,15,0">
                                        <iconPacks:PackIconMaterial Kind="Pencil" Foreground="#F39C12"/>
                                    </Button>

                                    <Button Command="{Binding DataContext.VerHistorialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Ver Historial Médico">
                                        <iconPacks:PackIconMaterial Kind="ClipboardTextClock" Foreground="#8E44AD"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>