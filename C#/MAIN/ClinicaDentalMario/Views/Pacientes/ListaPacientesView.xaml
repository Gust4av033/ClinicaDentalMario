<UserControl x:Class="ClinicaDentalMario.Views.Pacientes.ListaPacientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource BgWindowBrush}">

    <Border Background="{StaticResource BgCardBrush}" CornerRadius="15" Margin="10" Padding="25" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#000000" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Inactivos -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Nuevo Paciente -->
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="AccountGroup" Width="26" Height="26" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="Pacientes Registrados" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- BUSCADOR -->
                <Border Grid.Column="1" Background="{StaticResource BgControlBrush}" CornerRadius="20" Height="42" MaxWidth="450" Margin="20,0" Padding="15,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="Magnify" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                        <TextBox x:Name="txtBuscador" Grid.Column="1" Text="{Binding TerminoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="10,0,0,0" 
                                 FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBlock Grid.Column="1" Text="Buscar por nombre o número de DUI..." Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtBuscador}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtBuscador}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- BOTÓN DE INACTIVOS -->
                <ToggleButton Grid.Column="2" IsChecked="{Binding MostrarInactivos, UpdateSourceTrigger=PropertyChanged}" 
                              Margin="0,0,15,0" Height="42" Padding="15,0" Background="Transparent" 
                              Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Cursor="Hand">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#1AE74C3C"/>
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                    <Setter Property="BorderBrush" Value="#E74C3C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ArchiveOffOutline" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Ver Inactivos" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </ToggleButton>

                <!-- NUEVO PACIENTE -->
                <Button Grid.Column="3" Command="{Binding NuevoPacienteCommand}" Height="42" Background="#27AE60" Foreground="White" BorderThickness="0" Padding="20,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="21"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AccountPlus" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                        <TextBlock Text="Nuevo Paciente" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Pacientes}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" RowHeight="50" FontSize="14" Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Expediente" Binding="{Binding IdPaciente}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="2*"/>
                    <DataGridTextColumn Header="DUI" Binding="{Binding DUI}" Width="150"/>
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="150"/>

                    <DataGridTemplateColumn Header="Acciones" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding DataContext.EditarPacienteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Editar Datos" Margin="0,0,15,0">
                                        <iconPacks:PackIconMaterial Kind="Pencil" Foreground="#F39C12" Width="20" Height="20"/>
                                    </Button>

                                    <Button Command="{Binding DataContext.VerHistorialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Ver Expediente Médico">
                                        <iconPacks:PackIconMaterial Kind="ClipboardTextClock" Foreground="#9B59B6" Width="20" Height="20"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Background="{StaticResource BgCardBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Pacientes.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Pacientes}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="AccountSearchOutline" Width="70" Height="70" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.3" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="No se encontraron pacientes" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Intenta buscar con otro nombre o revisa el filtro." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.8" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>  