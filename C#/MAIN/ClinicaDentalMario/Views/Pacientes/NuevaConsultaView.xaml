<UserControl x:Class="ClinicaDentalMario.Views.Pacientes.NuevaConsultaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
        <Border Background="White" CornerRadius="15" Padding="30" MaxWidth="700" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#D1D8E0" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <iconPacks:PackIconMaterial Kind="Stethoscope" Width="28" Height="28" Foreground="#9B59B6" Margin="0,0,10,0"/>
                    <TextBlock Text="Registrar Nueva Consulta" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>

                <TextBlock Text="{Binding MensajeError}" Foreground="#E74C3C" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensajeError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Background="#F8F9FA" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="#E1E5EA" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Account" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Paciente: " Foreground="#7F8C8D" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PacienteActual.NombreCompleto}" Foreground="#2C3E50" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Motivo de la visita de hoy:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NuevaConsulta.MotivoConsulta, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="14" Padding="8" BorderBrush="#BDC3C7" BorderThickness="1" 
                         Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Diagnóstico clínico:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NuevaConsulta.Diagnostico, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="14" Padding="8" BorderBrush="#BDC3C7" BorderThickness="1" 
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Plan de Tratamiento (Qué se le hará):" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NuevaConsulta.PlanTratamiento, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="14" Padding="8" BorderBrush="#BDC3C7" BorderThickness="1" 
                         Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Receta u Observaciones extras:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NuevaConsulta.Observaciones, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="14" Padding="8" BorderBrush="#BDC3C7" BorderThickness="1" 
                         Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,25">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CancelarCommand}" Background="Transparent" Foreground="#7F8C8D" BorderBrush="#BDC3C7" BorderThickness="1" Height="40" Padding="20,0" Margin="0,0,15,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cancelar" FontSize="14" FontWeight="SemiBold"/>
                    </Button>

                    <Button Command="{Binding GuardarCommand}" Background="#9B59B6" Foreground="White" BorderThickness="0" Height="40" Padding="25,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Guardar Consulta" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>