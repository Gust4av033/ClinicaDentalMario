<Window x:Class="ClinicaDentalMario.Views.Pacientes.NuevaConsultaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Nueva Consulta Clínica"
        Height="760"
        Width="720"
        MinHeight="650"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BgWindowBrush}">

    <Border Padding="25"
            Background="{StaticResource BgCardBrush}"
            CornerRadius="12"
            Margin="15"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Background="{StaticResource BgControlBrush}"
                            Padding="10"
                            CornerRadius="8"
                            Margin="0,0,15,0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <iconPacks:PackIconMaterial Kind="Stethoscope"
                                                    Width="26"
                                                    Height="26"
                                                    Foreground="{StaticResource AccentBrush}"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Registrar Nueva Consulta"
                                   FontSize="21"
                                   FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Paciente: "
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding NombrePaciente}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Background="#3A1C1C"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensajeError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AlertCircle"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding MensajeError}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Doctor que atendió *"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding ListaDoctores}"
                              SelectedItem="{Binding DoctorSeleccionado, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                              DisplayMemberPath="NombreCompleto"
                              Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                              Margin="0,0,0,16"/>

                    <TextBlock Text="Motivo de la consulta *"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox Text="{Binding MotivoConsulta, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                             Height="58"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             MaxLength="1000"/>

                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="Antecedentes generales del expediente"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Estos datos provienen de la ficha base del paciente. No se modifican desde esta consulta."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource BgControlBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Médicos"
                                               FontWeight="Bold"
                                               Foreground="#F39C12"/>
                                    <TextBlock Text="{Binding ResumenAntecedentesMedicos}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{StaticResource BgControlBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Odontológicos"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{Binding ResumenAntecedentesOdontologicos}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#3A3219"
                                BorderBrush="#C99A20"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TieneAntecedentesGenerales}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Este paciente aún no tiene una ficha general de antecedentes. Conviene completarla desde Editar Paciente."
                                       Foreground="#E6C965"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="Cambios o información relevante de esta visita"
                                   FontSize="15"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Solo escribe aquí antecedentes nuevos, cambios o información que sea relevante específicamente para la consulta de hoy."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cambios médicos (opcional)"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CambiosAntecedentesMedicos, UpdateSourceTrigger=PropertyChanged}"
                                         Height="72"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cambios odontológicos (opcional)"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CambiosAntecedentesOdontologicos, UpdateSourceTrigger=PropertyChanged}"
                                         Height="72"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Diagnóstico clínico *"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,18,0,5"/>
                    <TextBox Text="{Binding Diagnostico, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                             Height="68"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <Border Background="#1A252F"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,18,0,0"
                            BorderBrush="#2C3E50"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Plan de tratamiento / procedimiento realizado *"
                                       Foreground="#3498DB"
                                       FontWeight="Bold"
                                       Margin="0,0,0,7"/>
                            <TextBox Text="{Binding PlanTratamiento, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                                     Height="90"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Observaciones adicionales"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,18,0,5"/>
                    <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"
                             Height="65"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding CerrarVentanaCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="42"
                        Padding="16,0"
                        Background="Transparent"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Cancel"
                                                    Margin="0,0,8,0"
                                                    Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding GuardarConsultaCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="42"
                        Padding="16,0"
                        Background="{StaticResource SuccessBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSave"
                                                    Margin="0,0,8,0"
                                                    Foreground="White"/>
                        <TextBlock Text="Guardar" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Command="{Binding GuardarYAsignarTratamientoCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="42"
                        Padding="16,0"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        ToolTip="Guarda la consulta y abre el registro de tratamiento">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ClipboardPlusOutline"
                                                    Margin="0,0,8,0"
                                                    Foreground="White"/>
                        <TextBlock Text="Guardar y asignar tratamiento"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
