<Window x:Class="ClinicaDentalMario.Views.Pacientes.NuevaConsultaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Nueva Consulta Clínica" Height="650" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgWindowBrush}">

    <Border Padding="25" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="{StaticResource BgControlBrush}" Padding="10" CornerRadius="8" Margin="0,0,15,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <iconPacks:PackIconMaterial Kind="Stethoscope" Width="26" Height="26" Foreground="{StaticResource AccentBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Registrar Nueva Consulta" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtNombrePaciente" Text="Paciente: Cargando..." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Motivo de la Consulta:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,5,0,5"/>
                    <TextBox x:Name="TxtMotivo" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8" FontSize="14"/>

                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Antecedentes Médicos:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtAntMedicos" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Antecedentes Odontológicos:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtAntOdontologicos" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8" FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Diagnóstico Clínico:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <TextBox x:Name="TxtDiagnostico" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8" FontSize="14"/>

                    <StackPanel Margin="0,15,0,0">
                        <TextBlock Text="Plan de Tratamiento (Detalle de Materiales, Piezas, etc.):" Foreground="#3498DB" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Ej: Extracción pieza #36 / Puente de Zirconia / Resina Estética..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,5" FontStyle="Italic"/>
                        <TextBox x:Name="TxtPlanTratamiento" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="14" BorderBrush="#3498DB" BorderThickness="1.5"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancelar" Click="BtnCancelar_Click" Height="40" Background="{StaticResource BgControlBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" Content="Guardar Historial" Click="BtnGuardar_Click" Height="40" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>