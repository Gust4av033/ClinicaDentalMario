<UserControl x:Class="ClinicaDentalMario.Views.Pacientes.OdontogramaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:ClinicaDentalMario.Views.Pacientes"
             Background="Transparent">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,15,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D1D8E0" Opacity="0.5"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>

                    <TextBlock Text="Kit Clínico UNAH-VS" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <Button Command="{Binding AbrirManualCommand}" Background="#F39C12" Foreground="White" BorderThickness="0" Height="35" Cursor="Hand" Margin="0,0,0,20">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilePdfBox" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Ver Normativas del Manual" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="1. Rellenos de Caras" Foreground="#7F8C8D" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Button Command="{Binding ActivarHerramientaCommand}" CommandParameter="Pintar|#E74C3C||Pintar Caries (Rojo)" Background="White" BorderBrush="#E74C3C" BorderThickness="1.5" Height="35" Cursor="Hand" Margin="0,0,0,5">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                            <Ellipse Width="14" Height="14" Fill="#E74C3C" Margin="0,0,10,0"/>
                            <TextBlock Text="Caries (Rojo)" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ActivarHerramientaCommand}" CommandParameter="Pintar|#3498DB||Pintar Obturación (Azul)" Background="White" BorderBrush="#3498DB" BorderThickness="1.5" Height="35" Cursor="Hand" Margin="0,0,0,15">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                            <Ellipse Width="14" Height="14" Fill="#3498DB" Margin="0,0,10,0"/>
                            <TextBlock Text="Obturación Sana (Azul)" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="2. Estados y Extracciones" Foreground="#7F8C8D" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Button Command="{Binding ActivarHerramientaCommand}" CommandParameter="Cruz|#E74C3C||Extracción Indicada (X)" Background="White" BorderBrush="#E74C3C" BorderThickness="1.5" Height="35" Cursor="Hand" Margin="0,0,0,5">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                            <iconPacks:PackIconMaterial Kind="CloseThick" Foreground="#E74C3C" Width="14" Height="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Extracción Indicada (X)" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ActivarHerramientaCommand}" CommandParameter="Diagonal|#3498DB||Diente Ausente (/)" Background="White" BorderBrush="#3498DB" BorderThickness="1.5" Height="35" Cursor="Hand" Margin="0,0,0,15">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                            <iconPacks:PackIconMaterial Kind="SlashForward" Foreground="#3498DB" Width="14" Height="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Diente Ausente (/)" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="3. Tratamientos y Coronas" Foreground="#7F8C8D" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ActivarHerramientaCommand}" CommandParameter="Circulo|#3498DB||Corona Buena" Background="White" BorderBrush="#3498DB" BorderThickness="1.5" Height="35" Cursor="Hand" Margin="0,0,2,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Corona (O Azul)" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ActivarHerramientaCommand}" CommandParameter="Raiz|#3498DB||Endodoncia Buena" Background="White" BorderBrush="#3498DB" BorderThickness="1.5" Height="35" Cursor="Hand" Margin="2,0,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Endodoncia (| Azul)" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        </Button>
                    </Grid>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ActivarHerramientaCommand}" CommandParameter="Circulo|#E74C3C||Corona Mala" Background="White" BorderBrush="#E74C3C" BorderThickness="1.5" Height="35" Cursor="Hand" Margin="0,0,2,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Corona (O Roja)" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ActivarHerramientaCommand}" CommandParameter="Raiz|#E74C3C||Endodoncia Mala" Background="White" BorderBrush="#E74C3C" BorderThickness="1.5" Height="35" Cursor="Hand" Margin="2,0,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Endodoncia (| Roja)" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="4. Anotaciones Especiales" Foreground="#7F8C8D" FontWeight="Bold" Margin="0,0,0,5"/>
                    <WrapPanel Margin="0,0,0,15">
                        <Button Command="{Binding ActivarHerramientaCommand}" CommandParameter="Siglas|#E74C3C|RR|Remanente Radicular (RR)" Content="RR" Width="40" Background="#FADBD8" Foreground="#C0392B" FontWeight="Bold" Margin="0,0,5,5"/>
                        <Button Command="{Binding ActivarHerramientaCommand}" CommandParameter="Siglas|#E74C3C|ME|Mal Estado (ME)" Content="ME" Width="40" Background="#FADBD8" Foreground="#C0392B" FontWeight="Bold" Margin="0,0,5,5"/>
                        <Button Command="{Binding ActivarHerramientaCommand}" CommandParameter="Siglas|#E74C3C|S|Sellante Malo (S)" Content="S" Width="40" Background="#FADBD8" Foreground="#C0392B" FontWeight="Bold" Margin="0,0,5,5"/>
                        <Button Command="{Binding ActivarHerramientaCommand}" CommandParameter="Siglas|#3498DB|IMP|Implante (IMP)" Content="IMP" Width="40" Background="#D6EAF8" Foreground="#2980B9" FontWeight="Bold" Margin="0,0,5,5"/>
                        <Button Command="{Binding ActivarHerramientaCommand}" CommandParameter="Siglas|#3498DB|MAC|Macrodoncia (MAC)" Content="MAC" Width="45" Background="#D6EAF8" Foreground="#2980B9" FontWeight="Bold" Margin="0,0,5,5"/>
                        <Button Command="{Binding ActivarHerramientaCommand}" CommandParameter="Siglas|#3498DB|M1|Movilidad Grado 1 (M1)" Content="M1" Width="40" Background="#D6EAF8" Foreground="#2980B9" FontWeight="Bold" Margin="0,0,5,5"/>
                    </WrapPanel>

                    <TextBlock Text="5. Controles Universales" Foreground="#7F8C8D" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ActivarHerramientaCommand}" CommandParameter="Borrador|#FFFFFF||Borrador Activo" Background="#ECF0F1" Foreground="#2C3E50" BorderThickness="0" Height="35" Cursor="Hand" Margin="0,0,5,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Eraser" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Borrador" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding ActivarHerramientaCommand}" CommandParameter="Ninguno|#FFFFFF||Cursor Normal" Background="#ECF0F1" Foreground="#2C3E50" BorderThickness="0" Height="35" Cursor="Hand" Margin="5,0,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CursorDefaultOutline" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Soltar" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Button Command="{Binding LimpiarTodoCommand}" Background="#E74C3C" Foreground="White" BorderThickness="0" Height="35" Cursor="Hand" Margin="0,10,0,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Broom" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Limpiar Todo el Mapa" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Border Background="#2C3E50" CornerRadius="8" Padding="15" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="HERRAMIENTA ACTIVA:" FontSize="11" Foreground="#95A5A6" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TextoHerramienta}" FontSize="14" Foreground="#2ECC71" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D1D8E0" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Mapeo Dental del Paciente" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                <Border Grid.Row="1" Background="#F4F6F7" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Ver Historial Guardado:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,10,0"/>

                        <ComboBox Grid.Column="1" ItemsSource="{Binding FechasGuardadas}" SelectedItem="{Binding FechaSeleccionada}" FontSize="14" Padding="5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat=dd/MM/yyyy - hh:mm tt}" FontWeight="Bold" Foreground="#2980B9"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="3" Command="{Binding EliminarOdontogramaCommand}" Background="Transparent" Foreground="#E74C3C" BorderBrush="#E74C3C" BorderThickness="1" Padding="15,5" Cursor="Hand" ToolTip="Eliminar esta fecha guardada">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="TrashCan" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Eliminar Fecha" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10">
                        <TextBlock Text="Maxilar Superior" Foreground="#7F8C8D" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding DientesSuperiores}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:PiezaDentalControl Margin="2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="2" Background="#BDC3C7" Margin="0,20" Opacity="0.5"/>

                        <TextBlock Text="Maxilar Inferior" Foreground="#7F8C8D" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding DientesInferiores}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:PiezaDentalControl Margin="2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="3" Command="{Binding GuardarOdontogramaCommand}" HorizontalAlignment="Right" Height="45" Background="#27AE60" Foreground="White" BorderThickness="0" Padding="25,0" Cursor="Hand" Margin="0,20,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSaveCheck" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Guardar Evolución Odontológica" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>