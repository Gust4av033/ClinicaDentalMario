<UserControl x:Class="ClinicaDentalMario.Views.Pacientes.PiezaDentalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="50"
             Height="96"
             Cursor="Hand"
             ToolTip="{Binding NumeroPieza, StringFormat=Pieza {0}}">

    <Border BorderBrush="{Binding ColorSeleccionCanvas}"
            BorderThickness="2"
            CornerRadius="7"
            Padding="1"
            Background="Transparent">
        <StackPanel>
            <TextBlock Text="{Binding NumeroPieza}"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,2"/>

            <Viewbox Width="45" Height="67">
                <Grid Width="50" Height="72">
                    <!-- Raíz / furca -->
                    <Path Data="M 18,5 L 25,18 M 25,5 L 32,18"
                          Stroke="{Binding ColorFurca}"
                          StrokeThickness="2.5"
                          IsHitTestVisible="False"/>
                    <Path Data="M 25,0 L 25,20"
                          Stroke="{Binding ColorRaiz}"
                          StrokeThickness="4"
                          IsHitTestVisible="False"/>

                    <!-- Superficies -->
                    <Grid Margin="0,20,0,0"
                          Width="50"
                          Height="50"
                          VerticalAlignment="Top">
                        <Path Data="M 0,0 L 50,0 L 35,15 L 15,15 Z"
                              Fill="{Binding ColorArriba}"
                              Stroke="#7F8C8D"
                              StrokeThickness="1.5">
                            <Path.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.InteraccionarCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                              CommandParameter="Arriba"/>
                            </Path.InputBindings>
                        </Path>
                        <Path Data="M 50,0 L 50,50 L 35,35 L 35,15 Z"
                              Fill="{Binding ColorDerecha}"
                              Stroke="#7F8C8D"
                              StrokeThickness="1.5">
                            <Path.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.InteraccionarCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                              CommandParameter="Derecha"/>
                            </Path.InputBindings>
                        </Path>
                        <Path Data="M 0,50 L 50,50 L 35,35 L 15,35 Z"
                              Fill="{Binding ColorAbajo}"
                              Stroke="#7F8C8D"
                              StrokeThickness="1.5">
                            <Path.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.InteraccionarCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                              CommandParameter="Abajo"/>
                            </Path.InputBindings>
                        </Path>
                        <Path Data="M 0,0 L 0,50 L 15,35 L 15,15 Z"
                              Fill="{Binding ColorIzquierda}"
                              Stroke="#7F8C8D"
                              StrokeThickness="1.5">
                            <Path.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.InteraccionarCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                              CommandParameter="Izquierda"/>
                            </Path.InputBindings>
                        </Path>
                        <Path Data="M 15,15 L 35,15 L 35,35 L 15,35 Z"
                              Fill="{Binding ColorCentro}"
                              Stroke="#7F8C8D"
                              StrokeThickness="1.5">
                            <Path.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.InteraccionarCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                              CommandParameter="Centro"/>
                            </Path.InputBindings>
                        </Path>
                    </Grid>

                    <!-- Hallazgos superpuestos -->
                    <Path Data="M 0,70 L 50,20"
                          Stroke="{Binding ColorDiagonal}"
                          StrokeThickness="4"
                          IsHitTestVisible="False"/>
                    <Path Data="M 0,20 L 50,70 M 50,20 L 0,70"
                          Stroke="{Binding ColorCruz}"
                          StrokeThickness="4"
                          IsHitTestVisible="False"/>
                    <Ellipse Stroke="{Binding ColorCirculo}"
                             StrokeThickness="3.5"
                             Fill="Transparent"
                             Margin="-5,15,-5,-5"
                             IsHitTestVisible="False"/>
                    <Path Data="M 10,45 L 40,45"
                          Stroke="{Binding ColorImpactadoRojo}"
                          StrokeThickness="4"
                          IsHitTestVisible="False"/>
                    <Path Data="M 5,35 L 45,35 M 5,55 L 45,55"
                          Stroke="{Binding ColorRemanenteLineas}"
                          StrokeThickness="2.5"
                          IsHitTestVisible="False"/>
                    <Path Data="M 5,34 L 13,41 L 21,33 L 29,43 L 37,34 L 45,42"
                          Stroke="{Binding ColorFractura}"
                          StrokeThickness="3"
                          StrokeLineJoin="Round"
                          IsHitTestVisible="False"/>
                    <Path Data="M 39,29 L 49,36 M 39,58 L 49,51"
                          Stroke="{Binding ColorDesbordante}"
                          StrokeThickness="3"
                          IsHitTestVisible="False"/>

                    <!-- Movimiento y siglas -->
                    <TextBlock Text="{Binding SimboloMovimiento}"
                               Foreground="{Binding ColorMovimiento}"
                               FontSize="17"
                               FontWeight="ExtraBold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,-5,-3,0"
                               IsHitTestVisible="False"/>
                    <Border Background="#E6FFFFFF"
                            CornerRadius="2"
                            Padding="1,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,-7"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding Siglas}"
                                   Foreground="{Binding ColorSiglas}"
                                   FontSize="14"
                                   FontWeight="ExtraBold"
                                   IsHitTestVisible="False"/>
                    </Border>
                </Grid>
            </Viewbox>
        </StackPanel>
    </Border>
</UserControl>
