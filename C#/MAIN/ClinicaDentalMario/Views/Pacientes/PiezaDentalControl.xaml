<UserControl x:Class="ClinicaDentalMario.Views.Pacientes.PiezaDentalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="50" Height="90" Cursor="Hand">

    <StackPanel>
        <TextBlock Text="{Binding NumeroPieza}" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,2"/>

        <Viewbox Width="45" Height="65">
            <Grid Width="50" Height="70">

                <Path Data="M 25,0 L 25,20" Stroke="{Binding ColorRaiz}" StrokeThickness="4" IsHitTestVisible="False"/>

                <Grid Margin="0,20,0,0" Width="50" Height="50" VerticalAlignment="Top">
                    <Path Data="M 0,0 L 50,0 L 35,15 L 15,15 Z" Fill="{Binding ColorArriba}" Stroke="#7F8C8D" StrokeThickness="1.5">
                        <Path.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.InteraccionarCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="Arriba"/>
                        </Path.InputBindings>
                    </Path>
                    <Path Data="M 50,0 L 50,50 L 35,35 L 35,15 Z" Fill="{Binding ColorDerecha}" Stroke="#7F8C8D" StrokeThickness="1.5">
                        <Path.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.InteraccionarCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="Derecha"/>
                        </Path.InputBindings>
                    </Path>
                    <Path Data="M 0,50 L 50,50 L 35,35 L 15,35 Z" Fill="{Binding ColorAbajo}" Stroke="#7F8C8D" StrokeThickness="1.5">
                        <Path.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.InteraccionarCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="Abajo"/>
                        </Path.InputBindings>
                    </Path>
                    <Path Data="M 0,0 L 0,50 L 15,35 L 15,15 Z" Fill="{Binding ColorIzquierda}" Stroke="#7F8C8D" StrokeThickness="1.5">
                        <Path.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.InteraccionarCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="Izquierda"/>
                        </Path.InputBindings>
                    </Path>
                    <Path Data="M 15,15 L 35,15 L 35,35 L 15,35 Z" Fill="{Binding ColorCentro}" Stroke="#7F8C8D" StrokeThickness="1.5">
                        <Path.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.InteraccionarCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="Centro"/>
                        </Path.InputBindings>
                    </Path>

                    <Path Data="M 0,50 L 50,0" Stroke="{Binding ColorDiagonal}" StrokeThickness="4" IsHitTestVisible="False"/>
                    <Path Data="M 0,0 L 50,50 M 50,0 L 0,50" Stroke="{Binding ColorCruz}" StrokeThickness="4" IsHitTestVisible="False"/>
                    <Ellipse Stroke="{Binding ColorCirculo}" StrokeThickness="3.5" Fill="Transparent" Margin="-5" IsHitTestVisible="False"/>
                </Grid>

                <TextBlock Text="{Binding Siglas}" Foreground="{Binding ColorSiglas}" FontSize="16" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-8" IsHitTestVisible="False"/>
            </Grid>
        </Viewbox>
    </StackPanel>
</UserControl>