<UserControl x:Class="ClinicaDentalMario.Views.Pagos.EstadoCuentaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource BgWindowBrush}">

    <Border Background="{StaticResource BgCardBrush}"
            CornerRadius="15"
            Margin="10"
            Padding="24"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#000000" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABECERA -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="23" Background="#142B22" Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="CashRegister"
                                                        Width="26" Height="26"
                                                        Foreground="{StaticResource SuccessBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Estado de Cuenta y Pagos"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Consulta saldos, registra abonos y revisa el historial financiero."
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RecargarCommand}"
                            Height="40" Width="42"
                            Margin="0,0,8,0"
                            Background="{StaticResource BgControlBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="Recargar estado de cuenta">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="19" Height="19"/>
                    </Button>

                    <Button Command="{Binding ImprimirReciboGlobalCommand}"
                            Height="40"
                            Margin="0,0,8,0"
                            Padding="14,0"
                            Background="Transparent"
                            Foreground="{StaticResource AccentBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="Estado global del paciente">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FileDocumentMultipleOutline" Width="18" Height="18" Margin="0,0,7,0"/>
                            <TextBlock Text="Estado global" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ImprimirReciboCommand}"
                            Height="40"
                            Padding="14,0"
                            Background="{StaticResource BgControlBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="Recibo del tratamiento seleccionado">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ReceiptTextOutline" Width="18" Height="18" Margin="0,0,7,0"/>
                            <TextBlock Text="Recibo" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ERROR CONTROLADO DEL MÓDULO -->
            <Border Grid.Row="1"
                    Background="#3A1C1C"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10"
                    Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="AlertCircleOutline"
                                                    Width="18" Height="18"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- SELECCIÓN PRINCIPAL -->
            <Border Grid.Row="2"
                    Background="{StaticResource BgControlBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Buscar paciente"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="0"
                                 Text="{Binding BusquedaPaciente, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" FontSize="13"
                                 ToolTip="Nombre, DUI o teléfono"/>

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="Paciente"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="12,0,0,5"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  Margin="12,0,0,0"
                                  ItemsSource="{Binding ListaPacientes}"
                                  SelectedItem="{Binding PacienteSeleccionado}"
                                  DisplayMemberPath="NombreCompleto"
                                  Padding="7" FontSize="13"/>

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Tratamiento"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="12,0,0,5"/>
                        <ComboBox Grid.Row="1" Grid.Column="2"
                                  Margin="12,0,0,0"
                                  ItemsSource="{Binding ListaTratamientos}"
                                  SelectedItem="{Binding TratamientoSeleccionado}"
                                  DisplayMemberPath="NombreTratamiento"
                                  Padding="7" FontSize="13"/>
                    </Grid>

                    <Expander Header="Filtros de tratamientos"
                              Margin="0,12,0,0"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              IsExpanded="False">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding BusquedaTratamiento, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8" FontSize="12"
                                     ToolTip="Buscar por tratamiento, doctor u observación"/>

                            <ComboBox Grid.Column="1"
                                      Margin="10,0,0,0"
                                      ItemsSource="{Binding EstadosFiltro}"
                                      SelectedItem="{Binding EstadoFiltroSeleccionado}"
                                      Padding="7" FontSize="12"/>

                            <Button Grid.Column="2"
                                    Command="{Binding LimpiarFiltrosCommand}"
                                    Height="36"
                                    Margin="10,0,0,0"
                                    Padding="11,0"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FilterRemoveOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Limpiar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Expander>

                    <TextBlock Text="{Binding TextoEstadoTratamientos}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SinResultadosTratamientos}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- RESUMEN GLOBAL: SOLO CUANDO HAY PACIENTE -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PacienteSeleccionado}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="12" CornerRadius="8"
                        Background="{StaticResource BgControlBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Cargos del paciente" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding TotalCargosPaciente, StringFormat={}{0:C}}"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="12" CornerRadius="8"
                        Background="#142B22" BorderBrush="#1E4634" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Total pagado" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding TotalPagadoPaciente, StringFormat={}{0:C}}"
                                   Foreground="{StaticResource SuccessBrush}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Padding="12" CornerRadius="8"
                        Background="#3A1C1C" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Saldo global" Foreground="{StaticResource DangerBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding SaldoTotalPaciente, StringFormat={}{0:C}}"
                                   Foreground="{StaticResource DangerBrush}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RESUMEN DEL TRATAMIENTO EN UNA SOLA BARRA -->
            <Border Grid.Row="4"
                    Background="{StaticResource BgControlBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12"
                    Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TratamientoSeleccionado}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Costo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding CostoTotal, StringFormat={}{0:C}}"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Abonado" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding TotalAbonado, StringFormat={}{0:C}}"
                                   Foreground="{StaticResource SuccessBrush}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Pendiente" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding SaldoPendiente, StringFormat={}{0:C}}"
                                   Foreground="{StaticResource DangerBrush}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="10,0,18,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="Avance" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                            <TextBlock Text="{Binding PorcentajePagado, StringFormat={}{0:0}%}"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                        </Grid>
                        <ProgressBar Value="{Binding PorcentajePagado}" Maximum="100" Height="6" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="Estado" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EstadoTratamiento}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MOTIVO DE BLOQUEO DE ABONO -->
            <Border Grid.Row="5"
                    Background="#2B2920"
                    BorderBrush="#8A7440"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="9"
                    Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeAccionPago}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding MensajeAccionPago}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- HISTORIAL -->
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="History" Width="19" Height="19"
                                                        Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Historial de abonos" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Text="{Binding BusquedaPago, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8" FontSize="12"
                             ToolTip="Buscar por método, observación, fecha o monto"/>

                    <Button Grid.Column="2"
                            Command="{Binding NuevoAbonoCommand}"
                            Height="38"
                            Margin="10,0,0,0"
                            Padding="14,0"
                            Background="{StaticResource SuccessBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Disponible únicamente para tratamientos pendientes o en progreso con saldo">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="PlusCircleOutline" Width="18" Height="18" Margin="0,0,7,0"/>
                            <TextBlock Text="Registrar abono" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding HistorialPagos}"
                              SelectedItem="{Binding PagoSeleccionado}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="44"
                              FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha"
                                                Binding="{Binding FechaPago, StringFormat={}{0:dd/MM/yyyy hh:mm tt}}"
                                                Width="185"/>
                            <DataGridTextColumn Header="Método"
                                                Binding="{Binding MetodoPago}"
                                                Width="190"/>
                            <DataGridTextColumn Header="Observación"
                                                Binding="{Binding Observacion}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Monto"
                                                Binding="{Binding Monto, StringFormat={}{0:C}}"
                                                Width="135">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="{StaticResource BgCardBrush}" Margin="0,32,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TratamientoSeleccionado}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SinPagos}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="CashClock"
                                                        Width="54" Height="54"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Opacity="0.26"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding TextoHistorialPagos}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="Los abonos se conservan como historial financiero y no se eliminan desde esta pantalla."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <Button Command="{Binding VerDetalleCommand}"
                            HorizontalAlignment="Right"
                            Height="36"
                            Padding="13,0"
                            Background="{StaticResource BgControlBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="EyeOutline" Width="17" Height="17" Margin="0,0,6,0"/>
                            <TextBlock Text="Ver detalle" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- CARGA -->
            <Border Grid.RowSpan="7" Background="#66000000" CornerRadius="10" Panel.ZIndex="20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EstaCargando}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="190" Height="7" IsIndeterminate="True"/>
                    <TextBlock Text="Actualizando información..."
                               Foreground="White"
                               FontWeight="SemiBold"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
