<Window x:Class="ClinicaDentalMario.Views.Pagos.NuevoPagoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Registrar Abono"
        Height="600"
        Width="470"
        MinHeight="600"
        MinWidth="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgWindowBrush}">

    <Border Margin="16"
            Padding="26"
            Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                <Border Width="42" Height="42" CornerRadius="21" Background="#142B22" Margin="0,0,12,0">
                    <iconPacks:PackIconMaterial Kind="CashPlus"
                                                    Width="23" Height="23"
                                                    Foreground="{StaticResource SuccessBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Registrar nuevo abono"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="El saldo se valida nuevamente al guardar."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#142B22"
                    Padding="14"
                    CornerRadius="9"
                    Margin="0,0,0,16"
                    BorderBrush="#1E4634"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tratamiento"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NombreTratamientoTexto}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,3,12,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="Saldo pendiente"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding SaldoPendiente, StringFormat={}{0:C}}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="#3A1C1C"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10"
                    Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Border>

            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Monto a abonar"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding MontoTexto, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="18"
                             Padding="10"
                             FontWeight="Bold"
                             Foreground="{StaticResource SuccessBrush}"
                             ToolTip="Ejemplo: 25.00"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding UsarSaldoTotalCommand}"
                        Content="Usar saldo total"
                        Height="38"
                        Margin="10,25,0,0"
                        Padding="12,0"
                        Background="Transparent"
                        Foreground="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        VerticalAlignment="Top">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <StackPanel Grid.Row="4" Margin="0,0,0,14">
                <TextBlock Text="Método de pago"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding MetodosPago}"
                          SelectedItem="{Binding MetodoPagoSeleccionado, Mode=TwoWay}"
                          FontSize="14"
                          Padding="8"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,0,0,12">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Concepto / observación"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Máx. 255 caracteres"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"/>
                </Grid>
                <TextBox Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="255"
                         Height="78"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8"
                         FontSize="13"/>
            </StackPanel>

            <Border Grid.Row="6"
                    Background="{StaticResource BgControlBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ShieldCheckOutline"
                                                    Width="18" Height="18"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Margin="0,0,8,0"/>
                    <TextBlock Text="El pago se conservará como parte del historial financiero del paciente."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="7" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding CancelarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="Cancelar"
                        Height="42"
                        Background="{StaticResource BgControlBrush}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding GuardarCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="42"
                        Background="{StaticResource SuccessBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ContentSaveCheckOutline"
                                                    Width="18" Height="18"
                                                    Margin="0,0,8,0"
                                                    Foreground="White"/>
                        <TextBlock Text="Guardar abono" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
