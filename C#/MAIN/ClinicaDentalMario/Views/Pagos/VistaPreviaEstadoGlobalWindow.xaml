<Window x:Class="ClinicaDentalMario.Views.Pagos.VistaPreviaEstadoGlobalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Estado de Cuenta Global" Height="700" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F4F6F7">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="BtnImprimir_Click" Background="#27AE60" Foreground="White" BorderThickness="0" Padding="15,8" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Printer" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                        <TextBlock Text="Imprimir Estado Global" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <DocumentViewer Grid.Row="1" Background="#ECF0F1">
            <FixedDocument x:Name="DocGlobal">
                <PageContent>
                    <FixedPage Width="793" Height="1122">
                        <Border Width="700" Margin="46" Padding="30" BorderBrush="#BDC3C7" BorderThickness="1" Background="White">

                            <!-- Forzamos tinta negra para impresión -->
                            <Border.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                            </Border.Resources>

                            <StackPanel>
                                <TextBlock Text="CLÍNICA DENTAL MARIO" FontSize="26" FontWeight="Bold" Foreground="#2980B9" HorizontalAlignment="Center"/>
                                <TextBlock Text="ESTADO DE CUENTA GENERAL Y RESUMEN FINANCIERO" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,20"/>

                                <Border BorderBrush="#7F8C8D" BorderThickness="0,0,0,2" Padding="0,0,0,10" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PacienteNombre}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding FechaEmision}" FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Encabezados de Tabla Global -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,0,2" Padding="5">
                                        <TextBlock Text="TRATAMIENTO" FontWeight="Bold"/>
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,2" Padding="5">
                                        <TextBlock Text="COSTO" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Border>
                                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,0,2" Padding="5">
                                        <TextBlock Text="ABONADO" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Border>
                                    <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,0,0,2" Padding="5">
                                        <TextBlock Text="SALDO" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Border>
                                    <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0,0,0,2" Padding="5">
                                        <TextBlock Text="ESTADO" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Contenedor dinámico donde inyectaremos los tratamientos -->
                                <StackPanel x:Name="ContenedorTratamientos" Margin="0,10,0,0"/>

                                <!-- Totales Globales -->
                                <Border BorderBrush="Black" BorderThickness="0,2,0,0" Padding="0,15,0,0" Margin="0,20,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="SALDO PENDIENTE TOTAL GENERAL: " FontWeight="Bold" FontSize="15"/>
                                        <TextBlock x:Name="TxtSaldoTotalGeneral" FontWeight="Bold" FontSize="16" Foreground="#C0392B"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,80,0,0" HorizontalAlignment="Center">
                                    <Border BorderBrush="Black" BorderThickness="0,1,0,0" Width="250" Padding="10,5,10,0">
                                        <TextBlock Text="Firma / Sello de Conformidad" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </FixedPage>
                </PageContent>
            </FixedDocument>
        </DocumentViewer>
    </Grid>
</Window>