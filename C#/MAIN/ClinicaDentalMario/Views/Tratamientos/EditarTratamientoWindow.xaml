<Window x:Class="ClinicaDentalMario.Views.Tratamientos.EditarTratamientoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Editar Tratamiento" Height="520" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F8F9FA">

    <Grid Margin="25">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <iconPacks:PackIconMaterial Kind="PencilOutline" Width="28" Height="28" Foreground="#F39C12" Margin="0,0,10,0"/>
                <TextBlock Text="Editar Tratamiento" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
            </StackPanel>

            <TextBlock Text="{Binding NombreTratamientoTexto}" FontSize="15" Foreground="#7F8C8D" Margin="0,0,0,20" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <TextBlock Text="{Binding MensajeError}" Foreground="#E74C3C" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,15">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="Costo Total Acordado ($):" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding CostoTotal, UpdateSourceTrigger=PropertyChanged}" 
                     FontSize="18" FontWeight="Bold" Foreground="#27AE60" Padding="8" BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,15"/>

            <TextBlock Text="Plan de Tratamiento / Observaciones:" Foreground="#3498DB" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}" 
                     FontSize="14" Padding="8" BorderBrush="#3498DB" BorderThickness="1.5" 
                     Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,25"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding CancelarCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                        Background="Transparent" Foreground="#7F8C8D" BorderBrush="#BDC3C7" BorderThickness="1" Height="40" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="Cancelar" FontSize="14" FontWeight="SemiBold"/>
                </Button>

                <Button Grid.Column="2" Command="{Binding GuardarCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                        Background="#F39C12" Foreground="White" BorderThickness="0" Height="40" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="ContentSaveEdit" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Actualizar" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>