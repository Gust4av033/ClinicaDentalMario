<UserControl x:Class="ClinicaDentalMario.Views.Tratamientos.NuevoTratamientoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource BgWindowBrush}">

    <Grid>
        <Border Background="{StaticResource BgCardBrush}" CornerRadius="15" Padding="35" MaxWidth="650" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <iconPacks:PackIconMaterial Kind="ToothOutline" Width="30" Height="30" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="Asignar Nuevo Tratamiento" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding NombrePacienteTexto}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20" FontWeight="SemiBold"/>

                <Border Background="#3A1C1C" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensajeError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AlertCircle" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Tratamiento Base a realizar" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding ListaCatalogo}" 
                              SelectedItem="{Binding TratamientoSeleccionado}" 
                              DisplayMemberPath="Nombre" 
                              FontSize="15" Padding="8"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Costo Total Acordado ($)" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBox Text="{Binding NuevoTratamiento.CostoTotal, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" 
                             Padding="8" PreviewTextInput="ValidarNumerosYDecimales_PreviewTextInput"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,25">
                    <TextBlock Text="Plan de Tratamiento (Detalle y Materiales):" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Ej: Puente de Zirconia, Piezas #14 a #16..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,5" FontStyle="Italic"/>
                    <TextBox Text="{Binding NuevoTratamiento.Observaciones, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="14" Padding="10" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" 
                             Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CancelarCommand}" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="42" Padding="25,0" Margin="0,0,15,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cancelar" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>

                    <Button Command="{Binding GuardarCommand}" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Height="42" Padding="30,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                            <TextBlock Text="Guardar y Asignar" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>