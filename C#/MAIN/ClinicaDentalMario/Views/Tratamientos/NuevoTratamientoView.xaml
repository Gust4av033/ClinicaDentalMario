<UserControl x:Class="ClinicaDentalMario.Views.Tratamientos.NuevoTratamientoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <Grid>
        <Border Background="White" CornerRadius="15" Padding="30" MaxWidth="600" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#D1D8E0" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <iconPacks:PackIconMaterial Kind="ToothOutline" Width="28" Height="28" Foreground="#3498DB" Margin="0,0,10,0"/>
                    <TextBlock Text="Asignar Nuevo Tratamiento" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>

                <TextBlock Text="{Binding NombrePacienteTexto}" FontSize="14" Foreground="#7F8C8D" Margin="0,0,0,20" FontWeight="SemiBold"/>

                <TextBlock Text="{Binding MensajeError}" Foreground="#E74C3C" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensajeError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Tratamiento Base a realizar:" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding ListaCatalogo}" 
                          SelectedItem="{Binding TratamientoSeleccionado}" 
                          DisplayMemberPath="Nombre" 
                          FontSize="14" Padding="8" BorderBrush="#BDC3C7" Margin="0,0,0,15"/>

                <TextBlock Text="Costo Total Acordado ($):" Foreground="#7F8C8D" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NuevoTratamiento.CostoTotal, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="18" FontWeight="Bold" Foreground="#27AE60" Padding="8" BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,15"/>
                <TextBlock Text="Plan de Tratamiento (Detalle y Materiales):" Foreground="#3498DB" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Ej: Puente de Zirconia, Piezas #14 a #16..." Foreground="#95A5A6" FontSize="11" Margin="0,0,0,5" FontStyle="Italic"/>
                <TextBox Text="{Binding NuevoTratamiento.Observaciones, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="14" Padding="8" BorderBrush="#3498DB" BorderThickness="1.5" 
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,25"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding CancelarCommand}" Background="Transparent" Foreground="#7F8C8D" BorderBrush="#BDC3C7" BorderThickness="1" Height="40" Padding="20,0" Margin="0,0,15,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Cancelar" FontSize="14" FontWeight="SemiBold"/>
                    </Button>

                    <Button Command="{Binding GuardarCommand}" Background="#3498DB" Foreground="White" BorderThickness="0" Height="40" Padding="25,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Guardar y Asignar" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>