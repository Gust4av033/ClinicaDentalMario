<UserControl x:Class="ClinicaDentalMario.Views.Tratamientos.NuevoTratamientoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource BgWindowBrush}">

    <Grid>
        <Border Background="{StaticResource BgCardBrush}"
                CornerRadius="15"
                Padding="32"
                MaxWidth="720"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#000000" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <iconPacks:PackIconMaterial Kind="ToothOutline"
                                                    Width="30"
                                                    Height="30"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    Margin="0,0,12,0"/>
                        <TextBlock Text="Asignar Nuevo Tratamiento"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding NombrePacienteTexto}"
                               FontSize="15"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="El tratamiento se registrará como Pendiente hasta que se inicie desde el listado."
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#3A1C1C"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensajeError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MensajeError}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AlertCircle"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    VerticalAlignment="Top"
                                                    Margin="0,1,8,0"/>
                        <TextBlock Text="{Binding MensajeError}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Tratamiento del catálogo"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding ListaCatalogo}"
                                  SelectedItem="{Binding TratamientoSeleccionado}"
                                  DisplayMemberPath="Nombre"
                                  FontSize="14"
                                  Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Doctor responsable"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding ListaDoctores}"
                                  SelectedItem="{Binding DoctorSeleccionado}"
                                  DisplayMemberPath="NombreCompleto"
                                  FontSize="14"
                                  Padding="8"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="3"
                        Background="{StaticResource BgControlBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding TratamientoSeleccionado.Descripcion, TargetNullValue=Selecciona un tratamiento para ver su descripción.}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="13"/>
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12">
                                <Run Text="Duración estimada: "/>
                                <Run Text="{Binding TratamientoSeleccionado.DuracionMinutos, TargetNullValue=—}" FontWeight="SemiBold"/>
                                <Run Text=" min"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="Precio base" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding TratamientoSeleccionado.PrecioBase, StringFormat={}{0:C}}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Costo Total Acordado ($)"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBox Text="{Binding NuevoTratamiento.CostoTotal, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="18"
                             FontWeight="Bold"
                             Foreground="{StaticResource SuccessBrush}"
                             Padding="8"
                             PreviewTextInput="ValidarNumerosYDecimales_PreviewTextInput"/>
                    <TextBlock Text="Puedes ajustar el precio base según el presupuesto acordado con el paciente."
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,0,0,20">
                    <TextBlock Text="Plan de Tratamiento / Observaciones"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Incluye piezas, fases, materiales o indicaciones clínicas relevantes."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="0,0,0,5"
                               FontStyle="Italic"/>
                    <TextBox Text="{Binding NuevoTratamiento.Observaciones, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Padding="10"
                             BorderBrush="{StaticResource AccentBrush}"
                             BorderThickness="1.5"
                             Height="95"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <Grid Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" Height="3" IsIndeterminate="True" Margin="0,0,0,12">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstaCargando}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelarCommand}"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Height="42"
                                Padding="25,0"
                                Margin="0,0,15,0"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Cancelar" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Button>

                        <Button Command="{Binding GuardarCommand}"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Height="42"
                                Padding="30,0"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ContentSave"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"
                                                            Foreground="White"/>
                                <TextBlock Text="Guardar y asignar"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
