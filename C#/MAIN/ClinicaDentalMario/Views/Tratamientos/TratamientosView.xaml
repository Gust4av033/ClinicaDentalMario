<UserControl x:Class="ClinicaDentalMario.Views.Tratamientos.TratamientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <Border Background="White" CornerRadius="15" Margin="10" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D1D8E0" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                <iconPacks:PackIconMaterial Kind="Tooth" Width="28" Height="28" Foreground="#3498DB" Margin="0,0,10,0"/>
                <TextBlock Text="Gestión de Tratamientos" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Seleccionar Paciente:" Foreground="#7F8C8D" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>

                <ComboBox Grid.Column="1" ItemsSource="{Binding ListaPacientes}" 
                          SelectedItem="{Binding PacienteSeleccionado}" 
                          DisplayMemberPath="NombreCompleto" 
                          IsEditable="True" TextSearch.TextPath="NombreCompleto"
                          FontSize="14" Padding="5" BorderBrush="#BDC3C7" Margin="0,0,20,0"/>

                <Button Grid.Column="2" Command="{Binding FinalizarTratamientoCommand}" Height="40" Background="#E67E22" Foreground="White" BorderThickness="0" Padding="15,0" Margin="0,0,10,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CheckCircle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Finalizar Seleccionado" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Command="{Binding NuevoTratamientoCommand}" Height="40" Background="#3498DB" Foreground="White" BorderThickness="0" Padding="15,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="PlusCircle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Asignar Nuevo Tratamiento" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <DataGrid Grid.Row="2" ItemsSource="{Binding TratamientosDelPaciente}" SelectedItem="{Binding TratamientoSeleccionado}" AutoGenerateColumns="False" 
                      CanUserAddRows="False" Background="White" BorderThickness="0" 
                      RowBackground="White" AlternatingRowBackground="#F9FAFC"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1E5EA"
                      HeadersVisibility="Column" RowHeight="45" FontSize="14">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F6FA"/>
                        <Setter Property="Foreground" Value="#7F8C8D"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E1E5EA"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha Inicio" Binding="{Binding FechaInicio, StringFormat=dd/MM/yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Tratamiento" Binding="{Binding NombreTratamiento}" Width="*"/>
                    <DataGridTextColumn Header="Costo Total" Binding="{Binding CostoTotal, StringFormat=C}" Width="120" FontWeight="Bold" Foreground="#27AE60"/>

                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Estado}" Value="En progreso">
                                        <Setter Property="Foreground" Value="#E67E22"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Estado}" Value="Finalizado">
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Acciones" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Ver detalles del plan">
                                    <iconPacks:PackIconMaterial Kind="Eye" Foreground="#3498DB" Width="20" Height="20"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>