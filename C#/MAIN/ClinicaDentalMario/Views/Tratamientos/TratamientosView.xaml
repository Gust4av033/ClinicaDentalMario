<UserControl x:Class="ClinicaDentalMario.Views.Tratamientos.TratamientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource BgWindowBrush}">

    <Border Background="{StaticResource BgCardBrush}" CornerRadius="15" Margin="10" Padding="25" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#000000" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                <iconPacks:PackIconMaterial Kind="Tooth" Width="30" Height="30" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="Gestión de Tratamientos y Presupuestos" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Seleccionar Paciente:" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="15"/>

                <!-- 🔥 COMBOBOX CON FILTRO EN TIEMPO REAL 🔥 -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding ListaPacientes}" 
                          SelectedItem="{Binding PacienteSeleccionado}" 
                          Text="{Binding BusquedaPaciente, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="NombreCompleto" 
                          IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False"
                          FontSize="15" Padding="8" Margin="0,0,20,0" VerticalAlignment="Center"/>

                <Button Grid.Column="2" Command="{Binding FinalizarTratamientoCommand}" Height="42" Background="#E67E22" Foreground="White" BorderThickness="0" Padding="20,0" Margin="0,0,12,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="21"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CheckCircle" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                        <TextBlock Text="Finalizar Seleccionado" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Command="{Binding NuevoTratamientoCommand}" Height="42" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="20,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="21"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="PlusCircle" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                        <TextBlock Text="Asignar Nuevo Tratamiento" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <DataGrid ItemsSource="{Binding TratamientosDelPaciente}" SelectedItem="{Binding TratamientoSeleccionado}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" Background="Transparent" BorderThickness="0" 
                          RowHeight="50" FontSize="14">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha Inicio" Binding="{Binding FechaInicio, StringFormat={}{0:dd/MM/yyyy}}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tratamiento / Descripción" Binding="{Binding NombreTratamiento}" Width="2*"/>

                        <DataGridTextColumn Header="Costo Total" Binding="{Binding CostoTotal, StringFormat={}{0:C}}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Estado}" Value="En progreso">
                                            <Setter Property="Foreground" Value="#E67E22"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Estado}" Value="Finalizado">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Acciones" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0" ToolTip="Ver detalles del plan">
                                            <iconPacks:PackIconMaterial Kind="Eye" Foreground="{StaticResource AccentBrush}" Width="20" Height="20"/>
                                        </Button>

                                        <Button Command="{Binding DataContext.EditarTratamientoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Editar costo o detalles">
                                            <iconPacks:PackIconMaterial Kind="Pencil" Foreground="#F39C12" Width="20" Height="20"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="{StaticResource BgCardBrush}" Margin="0,40,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TratamientosDelPaciente.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TratamientosDelPaciente}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ToothOutline" Width="80" Height="80" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.3" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="Sin tratamientos asignados" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Selecciona un paciente o haz clic en 'Asignar Nuevo Tratamiento'." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.8" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>