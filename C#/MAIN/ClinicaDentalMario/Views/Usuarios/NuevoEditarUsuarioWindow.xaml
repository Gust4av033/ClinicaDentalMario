<Window x:Class="ClinicaDentalMario.Views.Usuarios.NuevoEditarUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{Binding Titulo}" Height="660" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgWindowBrush}">

    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="15" Padding="24"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Border Width="40" Height="40" CornerRadius="9" Background="#253498DB" Margin="0,0,11,0">
                        <iconPacks:PackIconMaterial Kind="Account" Width="22" Height="22" Foreground="{StaticResource AccentBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Titulo}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Credenciales y permisos de acceso al sistema" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Border Visibility="{Binding EsUsuarioActual, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#253498DB" BorderBrush="#553498DB" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,13">
                    <TextBlock Text="Estás editando tu usuario actual. Para evitar perder acceso, no puedes desactivarlo ni retirar tu propio rol de Administrador."
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Nombre completo" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Usuario.NombreCompleto, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" Height="35" Margin="0,0,0,11"/>

                <TextBlock Text="Nombre de usuario (login)" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Usuario.NombreUsuario, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" Height="35" Margin="0,0,0,11"/>

                <TextBlock Text="Correo electrónico" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Usuario.Correo, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" Height="35" Margin="0,0,0,11"/>

                <TextBlock Text="Rol en el sistema" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Nombre" SelectedItem="{Binding RolSeleccionado}"
                          FontSize="14" Padding="7" Height="36" Margin="0,0,0,11"/>

                <TextBlock Text="Contraseña" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <PasswordBox x:Name="txtPassword" FontSize="14" Padding="8" Height="35" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding TextoAyudaPassword}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" FontStyle="Italic"/>

                <Border Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,12">
                    <CheckBox Content="Usuario activo" IsChecked="{Binding Usuario.Activo}" IsEnabled="{Binding PuedeCambiarEstado}"
                              FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>

                <TextBlock Text="{Binding MensajeError}" Foreground="#FF9A92" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding CancelarCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="{StaticResource BgControlBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="40" Cursor="Hand" Content="Cancelar"/>

                    <Button Grid.Column="2" Command="{Binding GuardarCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="Bold"
                            Height="40" BorderThickness="0" Cursor="Hand" Content="Guardar usuario"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
