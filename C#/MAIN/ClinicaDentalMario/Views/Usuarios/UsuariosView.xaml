<UserControl x:Class="ClinicaDentalMario.Views.Usuarios.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent">

    <Grid Margin="2,6,2,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Usuarios del sistema" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Administra credenciales, roles y estado de acceso."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding CargarUsuariosCommand}" Height="34" Padding="11,0" Margin="0,0,8,0"
                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Actualizar"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding NuevoUsuarioCommand}" Height="34" Padding="13,0"
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AccountPlus" Width="17" Height="17" Margin="0,0,6,0"/>
                        <TextBlock Text="Nuevo usuario" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <WrapPanel Margin="0,0,0,10">
                <Border Width="145" Margin="0,0,8,0" Padding="11" CornerRadius="9" Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Total" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding TotalUsuarios}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="20"/>
                    </StackPanel>
                </Border>
                <Border Width="145" Margin="0,0,8,0" Padding="11" CornerRadius="9" Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Activos" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding TotalActivos}" Foreground="#7ED6A5" FontWeight="Bold" FontSize="20"/>
                    </StackPanel>
                </Border>
                <Border Width="145" Margin="0,0,8,0" Padding="11" CornerRadius="9" Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Inactivos" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding TotalInactivos}" Foreground="#FF9A92" FontWeight="Bold" FontSize="20"/>
                    </StackPanel>
                </Border>
                <Border Width="145" Padding="11" CornerRadius="9" Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Administradores" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding TotalAdministradores}" Foreground="#8FC9F3" FontWeight="Bold" FontSize="20"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Background="{StaticResource BgControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="11">
                <WrapPanel>
                    <StackPanel Width="260" Margin="0,0,10,0">
                        <TextBlock Text="Buscar" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" Height="33" Padding="8,5"
                                 ToolTip="Nombre, usuario o correo"/>
                    </StackPanel>

                    <StackPanel Width="145" Margin="0,0,10,0">
                        <TextBlock Text="Estado" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding EstadosFiltro}" SelectedItem="{Binding EstadoSeleccionado}" Height="33"/>
                    </StackPanel>

                    <StackPanel Width="165" Margin="0,0,10,0">
                        <TextBlock Text="Rol" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding RolesFiltro}" SelectedItem="{Binding RolSeleccionado}" Height="33"/>
                    </StackPanel>

                    <Button Command="{Binding LimpiarFiltrosCommand}" Height="33" Padding="11,0" Margin="0,14,0,0"
                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FilterRemove" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Limpiar"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource BgControlBrush}" CornerRadius="10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Usuarios}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          Background="{StaticResource BgControlBrush}" BorderThickness="0"
                          RowBackground="{StaticResource BgControlBrush}" AlternatingRowBackground="#242424"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          HeadersVisibility="Column" RowHeight="43" FontSize="13">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,9"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="*" MinWidth="180"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding NombreUsuario}" Width="120"/>
                        <DataGridTextColumn Header="Rol" Binding="{Binding NombreRol}" Width="120"/>
                        <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="190"/>
                        <DataGridTemplateColumn Header="Estado" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="9" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#336B3030"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="True">
                                                        <Setter Property="Background" Value="#333B8F62"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Inactivo"/>
                                                    <Setter Property="Foreground" Value="#FF9A92"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="True">
                                                            <Setter Property="Text" Value="Activo"/>
                                                            <Setter Property="Foreground" Value="#7ED6A5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Creado" Binding="{Binding FechaCreacion, StringFormat={}{0:dd/MM/yyyy}}" Width="105"/>
                        <DataGridTemplateColumn Header="Acción" Width="82">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.EditarUsuarioCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Width="62" Height="29" Background="Transparent"
                                            Foreground="{StaticResource AccentBrush}" BorderBrush="#553498DB" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="Editar" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Cargando usuarios..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding EstaCargando, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding SinUsuarios, Converter={StaticResource BoolToVisibilityConverter}}">
                    <iconPacks:PackIconMaterial Kind="AccountSearch" Width="32" Height="32" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No hay usuarios que coincidan con los filtros." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
